{
  "name": "openclaw-plugin-pda-icon",
  "version": "0.1.0",
  "description": "PDA のアイコン (X1 門) を OpenClaw の Control UI に出す。",
  "type": "module",
  "private": true,
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json"
  },
  "files": [
    "dist",
    "assets",
    "themes",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.10-beta.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.10.10-beta.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.10.10-beta.1"
    },
    "build": {
      "openclawVersion": "2026.10.10-beta.1"
    }
  }
}
