{
  "id": "pda-ntfy",
  "name": "PDA ntfy notifications",
  "description": "オーナーとの会話への返事、承認待ち、エージェントからの質問を ntfy でスマートフォンへ通知します。",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ntfyEnvFile": {
        "type": "string",
        "minLength": 1,
        "default": "/home/user/.config/claude-login-notify/ntfy.env"
      },
      "controlUiUrl": { "type": "string" },
      "clickLinks": { "type": "boolean", "default": false },
      "clickUrl": { "type": "string" },
      "sessionKinds": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "default": ["main", "dashboard"]
      },
      "events": {
        "type": "array",
        "items": { "enum": ["reply", "approval", "question"] },
        "default": ["reply", "question"]
      },
      "excerptChars": { "type": "integer", "minimum": 0, "maximum": 500, "default": 100 },
      "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 30000, "default": 5000 }
    }
  }
}
