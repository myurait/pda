diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 79398b7d6..5929cba40 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -5349,6 +5349,37 @@ class ArtifactPreservationError(RuntimeError):
     """Raised when a declared scratch deliverable cannot be preserved."""
 
 
+def _live_foreign_claim(row) -> bool:
+    """Return True when ``row`` shows a running task owned by another live worker.
+
+    The guard is deliberately narrow so established manual flows keep working:
+
+    * no claim, non-running status, or an expired claim → not foreign;
+    * the calling process itself holds the claim (``claim_lock`` equals this
+      process's :func:`_claimer_id`) → not foreign (same-process claim →
+      terminal call is the historical single-worker pattern);
+    * the recorded ``worker_pid`` is dead → not foreign (nothing to strand).
+
+    What remains — a live claim held by a *different, still-alive* process —
+    is exactly the incident shape where an anonymous caller (e.g. a delegate
+    child that scrubbed its kanban env) would strand the owning worker on a
+    terminal task.
+    """
+    if row["claim_lock"] is None:
+        return False
+    if row["status"] != "running":
+        return False
+    expires = row["claim_expires"] if "claim_expires" in row.keys() else None
+    if expires is not None and int(expires) <= int(time.time()):
+        return False
+    if row["claim_lock"] == _claimer_id():
+        return False
+    pid = row["worker_pid"] if "worker_pid" in row.keys() else None
+    if pid is not None and not _pid_alive(int(pid)):
+        return False
+    return True
+
+
 def complete_task(
