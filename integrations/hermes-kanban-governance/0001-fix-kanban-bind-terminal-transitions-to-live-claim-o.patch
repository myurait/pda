+            return False
         source_status = (
             _retry_status_for_run(conn, task_id)
             if cur_row["status"] == "running"
@@ -7510,8 +7594,34 @@ def decompose_triage_task(
     return child_ids
 
 
-def archive_task(conn: sqlite3.Connection, task_id: str) -> bool:
+def archive_task(
+    conn: sqlite3.Connection, task_id: str, *, force: bool = False
+) -> bool:
+    """Archive a task.
+
+    Archiving a ``running`` task still owned by another live worker's claim
+    (see :func:`_live_foreign_claim`) requires ``force=True`` (explicit
+    operator override); otherwise the archive is refused and a
+    ``terminal_transition_refused`` event records the attempt, so a stray
+    caller cannot silently kill a live worker's claim.
+    """
     with write_txn(conn):
+        row = conn.execute(
+            "SELECT status, claim_lock, claim_expires, worker_pid "
+            "FROM tasks WHERE id = ?",
+            (task_id,),
+        ).fetchone()
+        if row is None:
+            return False
+        if not force and _live_foreign_claim(row):
+            _append_event(
+                conn, task_id, "terminal_transition_refused",
+                {
+                    "op": "archive",
+                    "reason": "live claim without force",
+                },
+            )
+            return False
         cur = conn.execute(
             "UPDATE tasks SET status = 'archived', "
             "    claim_lock = NULL, claim_expires = NULL, worker_pid = NULL "
diff --git a/tests/hermes_cli/test_kanban_terminal_claim_guard.py b/tests/hermes_cli/test_kanban_terminal_claim_guard.py
new file mode 100644
index 000000000..b01ac1c39
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_terminal_claim_guard.py
@@ -0,0 +1,189 @@
+"""Tests: terminal transitions are claim-lock-aware.
+
+``complete_task`` / ``block_task`` / ``archive_task`` used to accept an
+``expected_run_id=None`` call from any process and unconditionally clear a
+live worker's ``claim_lock`` / ``worker_pid``. A review-only delegate child
+that scrubbed its kanban env (so ``expected_run_id`` degraded to ``None``)
+could therefore force-complete its parent task while the owning worker was
+still alive, stranding the worker on a done task.
+
+These transitions now refuse anonymous calls against a *live foreign claim*
+(claim held by a different, still-alive process) unless the caller passes
+ownership proof (``expected_run_id``) or an explicit ``force=True`` override;
+a ``terminal_transition_refused`` event records each refused attempt. The
+historical same-process claim→terminal flow keeps working.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    db_path = kb.kanban_db_path(board="default")
+    kb._INITIALIZED_PATHS.discard(str(db_path.resolve()))
+    kb.init_db()
+    return home
+
+
+@pytest.fixture
+def conn(kanban_home):
+    with kb.connect() as c:
+        yield c
+
+
+@pytest.fixture
+def live_worker():
+    sleeper = subprocess.Popen(["sleep", "60"])
+    try:
+        yield sleeper
+    finally:
+        sleeper.kill()
+        sleeper.wait()
+
+
+def _foreign_claimed_task(conn, live_worker) -> tuple[str, int]:
+    """Create a running task owned by a different, still-alive process."""
+    host = kb._claimer_id().split(":", 1)[0]
+    tid = kb.create_task(conn, title="guarded work", assignee="default")
+    claimed = kb.claim_task(conn, tid, claimer=f"{host}:{live_worker.pid}")
+    assert claimed is not None
+    kb._set_worker_pid(conn, tid, live_worker.pid)
+    row = conn.execute(
+        "SELECT status, claim_lock, current_run_id FROM tasks WHERE id = ?",
+        (tid,),
+    ).fetchone()
+    assert row["status"] == "running" and row["claim_lock"] is not None
+    return tid, int(row["current_run_id"])
+
+
+def _refusal_events(conn, task_id: str) -> list:
+    return conn.execute(
+        "SELECT payload FROM task_events "
+        "WHERE task_id = ? AND kind = 'terminal_transition_refused'",
+        (task_id,),
+    ).fetchall()
+
+
+def test_complete_without_ownership_proof_is_refused_on_live_foreign_claim(
+    conn, live_worker
+):
+    task_id, _run_id = _foreign_claimed_task(conn, live_worker)
+
+    assert kb.complete_task(conn, task_id, result="stolen") is False
+
+    row = conn.execute(
+        "SELECT status, claim_lock FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()
+    assert row["status"] == "running"
+    assert row["claim_lock"] is not None
+    assert len(_refusal_events(conn, task_id)) == 1
+
+
+def test_complete_with_owner_run_id_or_force_still_works(conn, live_worker):
+    task_id, run_id = _foreign_claimed_task(conn, live_worker)
+    assert kb.complete_task(
+        conn, task_id, result="done", expected_run_id=run_id
+    ) is True
+
+    other_id, _ = _foreign_claimed_task(conn, live_worker)
+    assert kb.complete_task(conn, other_id, result="operator", force=True) is True
+
+
+def test_delegate_child_env_scrub_bypass_is_closed(conn, live_worker, monkeypatch):
+    # Incident replay: a review-only delegate child scrubs its kanban env
+    # (including HERMES_DELEGATED_CHILD_CONTEXT and HERMES_KANBAN_TASK), so
+    # its completion attempt arrives as an anonymous expected_run_id=None
+    # call from a process that does not own the live claim. The claim guard
+    # must refuse it even though the delegated-child gate no longer fires.
+    task_id, _run_id = _foreign_claimed_task(conn, live_worker)
+    for name in (
+        "HERMES_DELEGATED_CHILD_CONTEXT",
+        "HERMES_KANBAN_TASK",
+        "HERMES_KANBAN_RUN_ID",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    assert os.environ.get("HERMES_DELEGATED_CHILD_CONTEXT") is None
+
+    assert kb.complete_task(conn, task_id, result="bypass attempt") is False
+
+    row = conn.execute(
+        "SELECT status FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()
+    assert row["status"] == "running"
+    assert len(_refusal_events(conn, task_id)) == 1
+
+
+def test_block_without_ownership_proof_is_refused_on_live_foreign_claim(
+    conn, live_worker
+):
+    task_id, run_id = _foreign_claimed_task(conn, live_worker)
+
+    assert kb.block_task(conn, task_id, reason="stolen block") is False
+    row = conn.execute(
+        "SELECT status, claim_lock FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()
+    assert row["status"] == "running" and row["claim_lock"] is not None
+    assert len(_refusal_events(conn, task_id)) == 1
+
+    assert kb.block_task(
+        conn, task_id, reason="worker block", expected_run_id=run_id
+    ) is True
+
+
+def test_archive_of_live_foreign_claimed_task_requires_force(conn, live_worker):
+    task_id, _run_id = _foreign_claimed_task(conn, live_worker)
+
+    assert kb.archive_task(conn, task_id) is False
+    row = conn.execute(
+        "SELECT status, claim_lock FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()
+    assert row["status"] == "running" and row["claim_lock"] is not None
+    assert len(_refusal_events(conn, task_id)) == 1
+
+    assert kb.archive_task(conn, task_id, force=True) is True
+
+
+def test_same_process_claim_keeps_legacy_terminal_flows(conn):
+    # The single-process pattern used across the existing suite and manual
+    # operator sessions: claim in this process, then finish anonymously.
+    tid = kb.create_task(conn, title="own claim", assignee="default")
+    assert kb.claim_task(conn, tid) is not None
+    assert kb.complete_task(conn, tid, result="own done") is True
+    assert _refusal_events(conn, tid) == []
+
+
+def test_dead_claim_owner_does_not_block_terminal_flows(conn):
+    host = kb._claimer_id().split(":", 1)[0]
+    dead = subprocess.Popen(["true"])
+    dead.wait()
+    tid = kb.create_task(conn, title="dead owner", assignee="default")
+    assert kb.claim_task(conn, tid, claimer=f"{host}:{dead.pid}") is not None
+    kb._set_worker_pid(conn, tid, dead.pid)
+
+    assert kb.complete_task(conn, tid, result="recovered") is True
+    assert _refusal_events(conn, tid) == []
+
+
+def test_unclaimed_tasks_keep_legacy_manual_flows(conn):
+    ready = kb.create_task(conn, title="manual ready", assignee="default")
+    assert kb.complete_task(conn, ready, result="manual done") is True
+
+    other = kb.create_task(conn, title="manual block", assignee="default")
+    assert kb.block_task(conn, other, reason="waiting on input") is True
+
+    third = kb.create_task(conn, title="manual archive", assignee="default")
+    assert kb.archive_task(conn, third) is True
+    assert _refusal_events(conn, ready) == []
