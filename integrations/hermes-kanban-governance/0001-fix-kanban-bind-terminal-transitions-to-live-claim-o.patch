+    When the task is ``running`` under another live worker's claim (see
+    :func:`_live_foreign_claim`), a caller that supplies no
+    ``expected_run_id`` must pass ``force=True`` (explicit operator override)
+    — otherwise the completion is refused instead of silently clearing the
+    live worker's ``claim_lock``/``worker_pid``, and a
+    ``terminal_transition_refused`` event records the attempt. Workers prove
+    ownership by passing their own run id as ``expected_run_id``, and the
+    same-process claim→complete flow keeps working because the calling
+    process's claimer id matches the claim.
+
     Accepts a task that is merely ``ready`` too, so a manual CLI
     completion (``hermes kanban complete <id>``) works without requiring
     a claim/start/complete sequence. ``review`` is accepted so a human
@@ -5435,10 +5477,30 @@ def complete_task(
         if not _parents_satisfied(conn, task_id):
             return False
         prior = conn.execute(
-            "SELECT status FROM tasks WHERE id = ?",
+            "SELECT status, claim_lock, claim_expires, worker_pid "
+            "FROM tasks WHERE id = ?",
             (task_id,),
         ).fetchone()
         prior_status = prior["status"] if prior else None
+        # Refuse to clear another live worker's claim without proof of
+        # ownership (expected_run_id) or an explicit override (force=True).
+        # Closes the delegate-child / stranger-completion bypass where
+        # expected_run_id degrades to None after env scrubbing, while keeping
+        # the historical same-process claim→complete flow working.
+        if (
+            expected_run_id is None
+            and not force
+            and prior is not None
+            and _live_foreign_claim(prior)
+        ):
+            _append_event(
+                conn, task_id, "terminal_transition_refused",
+                {
+                    "op": "complete",
+                    "reason": "live claim without ownership proof or force",
+                },
+            )
+            return False
         if expected_run_id is None:
             cur = conn.execute(
                 """
@@ -6250,9 +6312,16 @@ def block_task(
     reason: Optional[str] = None,
     kind: Optional[str] = None,
     expected_run_id: Optional[int] = None,
+    force: bool = False,
 ) -> bool:
     """Transition ``running``/``ready`` → ``blocked`` (or route elsewhere).
 
+    When the task is ``running`` under another live worker's claim (see
+    :func:`_live_foreign_claim`), a caller that supplies no
+    ``expected_run_id`` must pass ``force=True`` — otherwise the block is
