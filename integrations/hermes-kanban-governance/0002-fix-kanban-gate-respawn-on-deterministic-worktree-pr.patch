diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 62c53c2..4e4742b 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -8134,6 +8134,70 @@ _RESPAWN_GUARD_PR_URL_RE = re.compile(
     re.IGNORECASE,
 )
 
+# --- Worktree progress judgment (respawn loop control) ---------------------
+#
+# ``detect_crashed_workers`` sends a clean-exit-without-terminal-call task
+# straight back to ``ready`` and lets the next tick re-spawn it, without ever
+# looking at what the crashed run actually produced. On a worktree task that
+# means a second worker session starts on the SAME checkout as the first,
+# blind to the first session's committed work — an uncontrolled retry that
+# risks duplicate execution, and, when nothing is produced at all, a silent
+# loop that only stops at the violation-streak ceiling.
+#
+# The judgment below is deterministic: git commits in the task's own worktree
+# plus the board's own run/event rows. No model, no heuristic scoring.
+
+# Consecutive no-progress crashed runs tolerated before the dispatcher stops
+# re-spawning and parks the task for a human decision. The first no-progress
+# crash still gets its retry (historical behaviour, and the empirical case for
+# retrying a protocol violation at all); a second run that also produced
+# nothing is a loop, and repeating it silently is the defect. The
+# violation-streak bound (``_PROTOCOL_VIOLATION_FAILURE_LIMIT``) stays in
+# place above this as the outer ceiling.
+_RESPAWN_NO_PROGRESS_LIMIT = 2
+
+# How far back to walk a task's closed runs when counting the no-progress
+# streak. The streak trips at 2, so a couple of dozen rows is far past it.
+_RESPAWN_PROGRESS_SCAN_LIMIT = 20
+
+# How many commits of the worktree's current tip are read when attributing
+# commits to a run's wall-clock window. A run that produced more than this
+# many commits made progress under any reading.
+_RESPAWN_PROGRESS_COMMIT_SCAN = 50
+
+# Seconds allowed for the worktree git read before it counts as unreadable.
+_RESPAWN_PROGRESS_GIT_TIMEOUT = 30
+
+# Event kinds a run emits when it reported its own outcome. A crashed run
+# that nevertheless carries one of these recorded a terminal signal whose
+# board transition did not take effect — a lost-handoff condition, not
+# something the dispatcher may resolve by starting another worker.
+_RESPAWN_COMPLETION_SIGNAL_KINDS = ("completed", "review_requested")
+
+# Ledger event: one recovery respawn was granted for a specific worktree tip.
+_RESPAWN_RECOVERY_EVENT = "respawn_recovery_granted"
+
+# Ledger event: the respawn loop was stopped and the task parked.
+_RESPAWN_PROGRESS_BLOCKED_EVENT = "respawn_progress_blocked"
+
+# Author recorded on the guard's card comment.
+_RESPAWN_GUARD_COMMENT_AUTHOR = "kanban-dispatcher"
+
+# Handed to the recovery worker by appending it to the crashed run's
+# ``task_runs.error``. That is the channel ``build_worker_context`` actually
+# renders: the "## Prior attempts on this task" section prints each closed
+# run's ``error`` as its ``_error_:`` line. ``tasks.last_failure_error`` is
+# NOT a worker channel — nothing on the spawn path reads it — so an
+# instruction written there would never reach the next worker.
+_RECOVERY_RESPAWN_INSTRUCTION = (
+    "RECOVERY RUN. The previous run committed work in this task's worktree "
+    "but never recorded a terminal kanban call. Do not redo the work: read "
+    "the worktree git log and diff first, confirm what the prior run "
+    "produced, then report that result with kanban_complete (or "
+    "kanban_block if it is genuinely unfinishable). This is the only "
+    "recovery run for the current worktree state."
+)
+
 
 @dataclass
 class DispatchResult:
@@ -9508,8 +9572,352 @@ def _clear_failure_counter(conn: sqlite3.Connection, task_id: str) -> None:
 _clear_spawn_failures = _clear_failure_counter
 
 
+def _worktree_commit_log(path: Optional[str]) -> Optional[list[tuple[str, int]]]:
+    """Return ``[(sha, commit_time), ...]`` newest-first for a task worktree.
+
+    ``None`` means the worktree could not be read as a git checkout at all
+    (path unset or gone, ``git`` missing or failing, unparsable output). The
+    caller treats that as *undeterminable* and fails closed: an unreadable
+    worktree is exactly the state in which "was there progress?" must not be
+    guessed.
+    """
+    if not path:
+        return None
+    try:
+        wt = Path(path).expanduser()
+    except (OSError, ValueError):
+        return None
+    if not wt.is_dir():
+        return None
+    try:
+        proc = subprocess.run(
+            [
+                "git", "-C", str(wt), "log",
+                "-n", str(_RESPAWN_PROGRESS_COMMIT_SCAN),
+                "--format=%H %ct",
+            ],
+            capture_output=True,
+            text=True,
+            timeout=_RESPAWN_PROGRESS_GIT_TIMEOUT,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if proc.returncode != 0:
+        return None
+    commits: list[tuple[str, int]] = []
+    for line in proc.stdout.splitlines():
+        if not line.strip():
+            continue
+        parts = line.split()
+        if len(parts) != 2:
+            return None
+        try:
+            commits.append((parts[0], int(parts[1])))
+        except ValueError:
+            return None
+    if not commits:
+        return None
+    return commits
+
+
+def _run_produced_commit(
+    commits: list[tuple[str, int]],
+    started_at: Optional[int],
+    ended_at: Optional[int],
+) -> bool:
+    """True when a worktree commit falls inside the run's wall-clock window.
+
+    The window is closed on both ends because a run is closed by the
+    dispatcher only after the worker process is gone, so a commit the worker
+    made is always at or before ``ended_at``. Attributing by window (rather
+    than by diffing against a stored base sha) needs nothing recorded ahead
+    of time, so the judgment also works for runs that closed before this
+    guard existed.
+    """
+    if started_at is None:
+        return False
+    lo = int(started_at)
+    hi = int(ended_at) if ended_at is not None else None
+    for _sha, ts in commits:
+        if ts < lo:
+            continue
+        if hi is not None and ts > hi:
+            continue
+        return True
+    return False
+
+
+def _completion_signal_in_run(
+    conn: sqlite3.Connection, task_id: str, run_id: Optional[int]
+) -> bool:
+    """True when ``run_id`` recorded a terminal signal on the card."""
+    if run_id is None:
+        return False
+    placeholders = ", ".join("?" for _ in _RESPAWN_COMPLETION_SIGNAL_KINDS)
+    row = conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? AND run_id = ? "
+        f"AND kind IN ({placeholders}) LIMIT 1",
+        (task_id, int(run_id), *_RESPAWN_COMPLETION_SIGNAL_KINDS),
+    ).fetchone()
+    return row is not None
+
+
+def _park_respawn_loop(
+    conn: sqlite3.Connection,
+    task_id: str,
+    reason: str,
+    note: str,
+    since: Optional[int],
+    *,
+    dry_run: bool,
+) -> str:
+    """Stop re-spawning ``task_id``: block it and leave one reason comment.
+
+    ``since`` is the latest closed run's ``ended_at``; a park already
+    recorded after that timestamp is not repeated, so the card gets exactly
+    one comment per stalled state instead of one per dispatcher tick. In
+    ``dry_run`` the reason is reported with no writes at all.
+
+    The ``blocked`` transition is attempted FIRST and nothing is recorded
+    unless it took effect. ``block_task`` can legitimately refuse — the
+    live-foreign-claim guard rejects an anonymous block when a fresh claim
+    landed between the dispatcher's ready snapshot and this call, and a card
+    that already left a blockable state is refused too. Recording the park
+    event before that refusal would leave the card neither blocked nor
+    re-spawnable: the dedup below would suppress every later park attempt
+    until a new run closed and moved ``since``.
+    """
+    if dry_run:
+        return reason
+    if since is not None:
+        already = conn.execute(
+            "SELECT 1 FROM task_events "
+            "WHERE task_id = ? AND kind = ? AND created_at >= ? LIMIT 1",
+            (task_id, _RESPAWN_PROGRESS_BLOCKED_EVENT, int(since)),
+        ).fetchone()
+        if already is not None:
+            return reason
+    if not block_task(conn, task_id, reason=note, kind="needs_input"):
+        # Refused. Leave no trace: ``reason`` is still returned, so this tick
+        # does not spawn, and with no park event written the dedup above lets
+        # the next tick retry the transition. ``block_task`` has already
+        # recorded its own ``terminal_transition_refused`` event when the
+        # refusal came from the claim guard.
+        _log.debug(
+            "respawn progress guard: block refused for %s (%s)",
+            task_id, reason,
+        )
+        return reason
+    with write_txn(conn):
+        _append_event(
+            conn, task_id, _RESPAWN_PROGRESS_BLOCKED_EVENT,
+            {"reason": reason, "note": note},
+        )
+    try:
+        add_comment(conn, task_id, _RESPAWN_GUARD_COMMENT_AUTHOR, note)
+    except (ValueError, sqlite3.Error):
+        # The reason is not lost if this fails: ``block_task`` stored it as
+        # the blocked run's summary.
+        _log.debug(
+            "respawn progress guard: could not comment on %s", task_id,
+            exc_info=True,
+        )
+    return reason
+
+
+def _respawn_recovery_spent(
+    conn: sqlite3.Connection, task_id: str, head: str
+) -> Optional[bool]:
+    """Has the single recovery respawn for worktree tip ``head`` been used?
+
+    ``None``  — no recovery was ever granted for this tip.
+    ``False`` — a grant exists but no later run closed (the spawn did not
+                actually happen, e.g. the claim was lost), so the grant still
+                stands and must not be re-issued.
+    ``True``  — a grant exists and a later run has closed, so the one
+                recovery attempt for this worktree state is spent.
+
+    "Later" is decided on ``task_runs.id`` (monotonic) rather than on
+    timestamps, so the answer cannot be changed by a clock adjustment.
+    A run that ended ``rate_limited`` does not count as the recovery
+    attempt: a provider quota wall says nothing about the task and the
+    granted recovery never actually got to run, exactly as such a run is
+    neutral for the no-progress streak and the unified failure counter.
+    """
+    grants = conn.execute(
+        "SELECT id, payload FROM task_events "
+        "WHERE task_id = ? AND kind = ? ORDER BY id DESC",
+        (task_id, _RESPAWN_RECOVERY_EVENT),
+    ).fetchall()
+    for grant in grants:
+        try:
+            payload = json.loads(grant["payload"]) if grant["payload"] else {}
+        except (ValueError, TypeError):
+            payload = {}
+        if not isinstance(payload, dict) or payload.get("head") != head:
+            continue
+        granted_after = payload.get("run_id")
+        if not isinstance(granted_after, int):
+            # Grant without a usable anchor: cannot prove the recovery run
+            # has not happened yet, so treat the budget as spent.
+            return True
+        ran = conn.execute(
+            "SELECT 1 FROM task_runs "
+            "WHERE task_id = ? AND id > ? AND ended_at IS NOT NULL "
+            "AND (outcome IS NULL OR outcome != 'rate_limited') LIMIT 1",
+            (task_id, granted_after),
+        ).fetchone()
+        return ran is not None
+    return None
+
+
+def _worktree_progress_guard(
+    conn: sqlite3.Connection, task_id: str, *, dry_run: bool = False,
+) -> Optional[str]:
+    """Decide whether a crashed worktree task may be re-spawned again.
+
+    Applies only to the uncontrolled-retry shape: a ``worktree`` workspace
+    whose latest closed run ended ``crashed`` (the outcome
+    ``detect_crashed_workers`` records for a dead worker and for a clean exit
+    without a terminal kanban call). Anything else — scratch/dir workspaces,
+    first spawns, completed / blocked / reclaimed / rate-limited latest runs —
+    returns ``None`` and keeps the historical behaviour untouched.
+
+    The verdicts, over (new commit in the worktree x terminal signal recorded
+    by the crashed run):
+
+    * commit, no signal → one **recovery** respawn per worktree tip. The
+      corrective text handed to the next worker says the work may already be
+      committed and asks it to verify and report rather than redo. A second
+      run against the same tip is refused (``recovery_exhausted``).
+    * no commit, no signal → the historical single retry, then
+      ``no_progress_blocked`` once the no-progress streak reaches
+      ``_RESPAWN_NO_PROGRESS_LIMIT``.
+    * signal recorded (with or without a commit) → ``completion_signal_lost``.
+      The run reported its own outcome and the board transition did not take
+      effect; starting another worker would paper over a lost handoff, so the
+      card is parked for a human decision instead.
+    * worktree unreadable / judgment impossible → ``progress_undeterminable``
+      (fail-closed).
+
+    Every parking verdict blocks the card and leaves exactly one comment
+    naming the reason — the loop never stops silently.
+    """
+    row = conn.execute(
+        "SELECT workspace_kind, workspace_path FROM tasks WHERE id = ?",
+        (task_id,),
+    ).fetchone()
+    if row is None or row["workspace_kind"] != "worktree":
+        return None
+    runs = [
+        r for r in conn.execute(
+            "SELECT id, outcome, started_at, ended_at FROM task_runs "
+            "WHERE task_id = ? AND ended_at IS NOT NULL "
+            "ORDER BY id DESC LIMIT ?",
+            (task_id, _RESPAWN_PROGRESS_SCAN_LIMIT),
+        ).fetchall()
+        # A provider quota wall is neutral about the task, exactly as it is
+        # for the unified failure counter and the violation streak.
+        if r["outcome"] != "rate_limited"
+    ]
+    if not runs:
+        return None
+    latest = runs[0]
+    if latest["outcome"] != "crashed":
+        return None
+    since = latest["ended_at"]
+
+    commits = _worktree_commit_log(row["workspace_path"])
+    if commits is None:
+        return _park_respawn_loop(
+            conn, task_id, "progress_undeterminable",
+            "Respawn stopped: this task's git worktree could not be read, so "
+            "whether the crashed run produced anything cannot be determined. "
+            "Re-spawning blind risks repeating or destroying committed work. "
+            "Restore or re-create the worktree, then unblock the card.",
+            since, dry_run=dry_run,
+        )
+    head = commits[0][0]
+
+    if _completion_signal_in_run(conn, task_id, latest["id"]):
+        return _park_respawn_loop(
+            conn, task_id, "completion_signal_lost",
+            "Respawn stopped: the last run recorded a terminal signal for "
+            "this card, yet the card came back to the work pool. The signal "
+            "was lost rather than the work, so a new worker session would "
+            "duplicate finished work. Reconcile the run's reported outcome "
+            "with the card, then unblock or close it.",
+            since, dry_run=dry_run,
+        )
+
+    spent = _respawn_recovery_spent(conn, task_id, head)
+    if spent is True:
+        return _park_respawn_loop(
+            conn, task_id, "recovery_exhausted",
+            "Respawn stopped: a recovery run was already granted for this "
+            "worktree state and it ended without reporting an outcome, with "
+            "no new commit. Further identical retries add nothing. Review "
+            "the worktree's committed work and close, re-scope, or re-queue "
+            "the card by hand.",
+            since, dry_run=dry_run,
+        )
+    if spent is False:
+        # Granted but never actually spawned — let the standing grant run.
+        return None
+
+    if _run_produced_commit(commits, latest["started_at"], latest["ended_at"]):
+        if dry_run:
+            return None
+        with write_txn(conn):
+            # Append to the crashed run's ``task_runs.error`` — the column
+            # ``build_worker_context`` renders as that attempt's ``_error_:``
+            # line — so the recovery worker actually sees the instruction.
+            # ``tasks.last_failure_error`` is deliberately left alone: no
+            # worker-context path reads it, and it carries the
+            # protocol-violation message ``detect_crashed_workers`` stamps
+            # for the board UI and ``kanban_diagnostics``.
+            conn.execute(
+                "UPDATE task_runs SET error = CASE "
+                "WHEN error IS NULL OR error = '' THEN ? ELSE error || ? END "
+                "WHERE id = ?",
+                (
+                    _RECOVERY_RESPAWN_INSTRUCTION,
+                    "\n\n" + _RECOVERY_RESPAWN_INSTRUCTION,
+                    int(latest["id"]),
+                ),
+            )
+            _append_event(
+                conn, task_id, _RESPAWN_RECOVERY_EVENT,
+                {"head": head, "run_id": int(latest["id"])},
+            )
+        return None
+
+    streak = 0
+    for run in runs:
+        if run["outcome"] != "crashed":
+            break
+        if _run_produced_commit(commits, run["started_at"], run["ended_at"]):
+            break
+        streak += 1
+    if streak >= _RESPAWN_NO_PROGRESS_LIMIT:
+        return _park_respawn_loop(
+            conn, task_id, "no_progress_blocked",
+            f"Respawn stopped: {streak} consecutive runs ended without a "
+            "terminal kanban call and without committing anything to this "
+            "task's worktree. Another identical attempt would repeat the "
+            "same empty run. Diagnose the card (scope, tooling, or worker "
+            "budget) before unblocking it.",
+            since, dry_run=dry_run,
+        )
+    return None
+
+
