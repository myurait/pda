+@pytest.fixture
+def worktree(tmp_path) -> Path:
+    """A git checkout standing in for a task worktree, with a base commit."""
+    repo = tmp_path / "wt"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    _git(repo, "config", "commit.gpgsign", "false")
+    (repo / "base.txt").write_text("base\n")
+    _git(repo, "add", "base.txt")
+    # Well before any run window in these tests.
+    _git(repo, "commit", "-q", "-m", "base", ts=BASE_TS - 10_000)
+    return repo
+
+
+def _commit(repo: Path, name: str, ts: int) -> None:
+    (repo / name).write_text(name + "\n")
+    _git(repo, "add", name)
+    _git(repo, "commit", "-q", "-m", name, ts=ts)
+
+
+def _worktree_task(conn, worktree: Path, **kw) -> str:
+    return kb.create_task(
+        conn,
+        title=kw.pop("title", "worktree work"),
+        assignee=kw.pop("assignee", "default"),
+        workspace_kind="worktree",
+        workspace_path=str(worktree),
+        **kw,
+    )
+
+
+def _closed_run(
+    conn,
+    task_id: str,
+    started_at: int,
+    ended_at: int,
+    *,
+    outcome: str = "crashed",
+) -> int:
+    """Insert a closed run directly.
+
+    The dispatcher's own crash path is exercised separately
+    (``test_dispatch_blocks_instead_of_respawning_a_stalled_worktree_task``);
+    here the run rows are written directly so each run's wall-clock window is
+    exact and the commit-attribution windows are unambiguous.
+    """
+    with kb.write_txn(conn):
+        cur = conn.execute(
+            "INSERT INTO task_runs (task_id, status, started_at, ended_at, "
+            "outcome, error) VALUES (?, ?, ?, ?, ?, ?)",
+            (task_id, outcome, started_at, ended_at, outcome, "worker gone"),
+        )
+        return int(cur.lastrowid)
+
+
+def _events(conn, task_id: str, kind: str) -> list:
+    return conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind = ?",
+        (task_id, kind),
+    ).fetchall()
+
+
+def _comments(conn, task_id: str) -> list[str]:
+    return [c.body for c in kb.list_comments(conn, task_id)]
+
+
+def _status(conn, task_id: str) -> str:
+    return conn.execute(
+        "SELECT status FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()["status"]
+
