+def test_a_rate_limited_run_does_not_spend_the_recovery_grant(conn, worktree):
+    # The granted recovery run died on a provider quota wall before doing
+    # anything. A quota wall is neutral about the task — as it is for the
+    # no-progress streak and the unified failure counter — so the grant still
+    # stands and must not be reported as spent.
+    #
+    # Asserted on the ledger helper rather than through
+    # ``check_respawn_guard``: when the latest closed run is ``rate_limited``
+    # the rate-limit cooldown check returns before the progress judgment ever
+    # runs, so the guard's answer cannot distinguish the two readings.
+    task_id = _worktree_task(conn, worktree)
+    _commit(worktree, "work.txt", BASE_TS + 50)
+    _closed_run(conn, task_id, BASE_TS, BASE_TS + 100)
+    assert kb.check_respawn_guard(conn, task_id) is None  # recovery granted
+    head = kb._worktree_commit_log(str(worktree))[0][0]
+
+    _closed_run(
+        conn, task_id, BASE_TS + 200, BASE_TS + 300, outcome="rate_limited"
+    )
+    assert kb._respawn_recovery_spent(conn, task_id, head) is False
+
+    # A recovery run that actually closes DOES spend it.
+    _closed_run(conn, task_id, BASE_TS + 400, BASE_TS + 500)
+    assert kb._respawn_recovery_spent(conn, task_id, head) is True
+    assert kb.check_respawn_guard(conn, task_id) == "recovery_exhausted"
