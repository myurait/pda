+    _closed_run(conn, task_id, BASE_TS, BASE_TS + 100)
+
+    assert kb.check_respawn_guard(conn, task_id) is None
+    assert _status(conn, task_id) == "ready"
+
+    grants = _events(conn, task_id, kb._RESPAWN_RECOVERY_EVENT)
+    assert len(grants) == 1
+
+    # The instruction has to reach the WORKER, not just a column: the prompt
+    # renders each prior attempt's ``task_runs.error``, and nothing on the
+    # spawn path reads ``tasks.last_failure_error``.
+    context = kb.build_worker_context(conn, task_id)
+    assert "RECOVERY RUN" in context
+    assert "kanban_complete" in context
+    # The crashed run's own error text survives in front of the instruction.
+    assert "worker gone" in context
+
+    # ...and the instruction must not read as a quota/credential blocker, or
+    # the blocker_auth check would park the card on the next tick.
+    assert kb.check_respawn_guard(conn, task_id) is None
