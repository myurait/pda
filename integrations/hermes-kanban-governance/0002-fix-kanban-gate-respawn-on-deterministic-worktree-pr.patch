+def test_a_refused_block_records_nothing_and_still_guards(conn, worktree):
+    # A claim can land between the dispatcher's ready snapshot and the park.
+    # ``block_task`` then refuses (patch 0001's live-foreign-claim guard). If
+    # the park event were written anyway, the dedup would suppress every later
+    # park attempt and the card would sit neither blocked nor spawnable.
+    task_id = _worktree_task(conn, worktree)
+    _closed_run(conn, task_id, BASE_TS, BASE_TS + 100)
+    _closed_run(conn, task_id, BASE_TS + 200, BASE_TS + 300)
+    _claim_for_a_live_stranger(conn, task_id)
+
+    assert kb.check_respawn_guard(conn, task_id) == "no_progress_blocked"
+    assert _status(conn, task_id) == "running"
+    assert _events(conn, task_id, kb._RESPAWN_PROGRESS_BLOCKED_EVENT) == []
+    assert _comments(conn, task_id) == []
+
+    # Claim gone: the very next call parks the card for real.
+    with kb.write_txn(conn):
+        conn.execute(
+            "UPDATE tasks SET status = 'ready', claim_lock = NULL, "
+            "claim_expires = NULL, worker_pid = NULL WHERE id = ?",
+            (task_id,),
+        )
+
+    assert kb.check_respawn_guard(conn, task_id) == "no_progress_blocked"
+    assert _status(conn, task_id) == "blocked"
+    assert len(_comments(conn, task_id)) == 1
+    assert len(_events(conn, task_id, kb._RESPAWN_PROGRESS_BLOCKED_EVENT)) == 1
