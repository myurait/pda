+def _claim_for_a_live_stranger(conn, task_id: str) -> None:
+    """Put the card under another live process's claim (patch 0001 shape)."""
+    with kb.write_txn(conn):
+        conn.execute(
+            "UPDATE tasks SET status = 'running', claim_lock = ?, "
+            "claim_expires = ?, worker_pid = ? WHERE id = ?",
