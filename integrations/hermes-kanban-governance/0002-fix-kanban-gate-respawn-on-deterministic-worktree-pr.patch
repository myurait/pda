diff --git a/tests/hermes_cli/test_kanban_respawn_progress_guard.py b/tests/hermes_cli/test_kanban_respawn_progress_guard.py
new file mode 100644
index 0000000..e1969f9
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_respawn_progress_guard.py
@@ -0,0 +1,599 @@
+"""Tests: the respawn guard judges worktree progress before re-spawning.
+
+``detect_crashed_workers`` closes a clean-exit-without-terminal-call run as
+``crashed``, sends the task straight back to ``ready``, and lets the next
+dispatcher tick spawn a fresh worker on the SAME worktree — without looking at
+what the crashed run produced. A second session therefore starts blind to the
+first session's committed work (duplicate-execution risk), and a task that
+produces nothing at all loops silently until the violation-streak ceiling.
+
+``check_respawn_guard`` now judges the crashed run deterministically — git
+commits in the task's own worktree, plus the terminal signals the run recorded
+on the card — and:
+
+* grants exactly one *recovery* respawn per worktree tip when the run
+  committed work but reported no outcome, telling the next worker — through
+  the crashed run's ``task_runs.error``, which is what the worker prompt
+  renders — to verify and report rather than redo;
+* allows the historical single retry when nothing was produced, then blocks at
+  a no-progress streak of two;
+* blocks when the run did record a terminal signal (a lost handoff, not
+  unfinished work);
+* blocks when the worktree cannot be read (fail-closed);
+
+and leaves exactly one reason comment on every blocking verdict, so the loop
+never stops silently. No model is involved in any of it.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import time
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+
+
+BASE_TS = 1_700_000_000
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    db_path = kb.kanban_db_path(board="default")
+    kb._INITIALIZED_PATHS.discard(str(db_path.resolve()))
+    kb.init_db()
+    return home
+
+
+@pytest.fixture
+def conn(kanban_home):
+    with kb.connect() as c:
+        yield c
+
+
+def _git(repo: Path, *args: str, ts: int | None = None) -> None:
+    env = dict(os.environ)
+    env.update(
+        GIT_AUTHOR_NAME="worker",
+        GIT_AUTHOR_EMAIL="worker@example.com",
+        GIT_COMMITTER_NAME="worker",
+        GIT_COMMITTER_EMAIL="worker@example.com",
+    )
+    if ts is not None:
+        # Commit date is what the guard reads, so pin both explicitly.
+        env["GIT_AUTHOR_DATE"] = f"@{ts} +0000"
+        env["GIT_COMMITTER_DATE"] = f"@{ts} +0000"
+    subprocess.run(
+        ["git", "-C", str(repo), *args],
+        check=True, env=env, capture_output=True, text=True,
+    )
