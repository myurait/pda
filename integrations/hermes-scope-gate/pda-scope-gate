#!/usr/bin/env python3
"""Out-of-process fail-closed entry point for the PDA scope gate."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sqlite3
import sys

from scope_gate import GateStore, default_state_path, validate_shell_payload


def _state_path() -> Path:
    override = os.environ.get("PDA_SCOPE_GATE_STATE", "").strip()
    return Path(override).expanduser().resolve() if override else default_state_path()


def _validate_tool() -> int:
    try:
        payload = json.load(sys.stdin)
        response = validate_shell_payload(payload, state_path=_state_path())
    except Exception as exc:
        print(f"pda-scope-gate validation failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(response, ensure_ascii=False, sort_keys=True))
    return 0


def _doctor() -> int:
    try:
        store = GateStore(_state_path())
        with store._connect() as connection:  # local operator diagnostic
            result = connection.execute("PRAGMA integrity_check").fetchone()[0]
        if result != "ok":
            raise RuntimeError(f"SQLite integrity_check returned {result!r}")
    except Exception as exc:
        print(f"scope gate unhealthy: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1
    print(json.dumps({"ok": True, "state_path": str(store.path), "integrity": "ok"}))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="pda-scope-gate")
    parser.add_argument("action", choices=("validate-tool", "doctor"))
    args = parser.parse_args()
    if args.action == "validate-tool":
        return _validate_tool()
    return _doctor()


if __name__ == "__main__":
    raise SystemExit(main())
