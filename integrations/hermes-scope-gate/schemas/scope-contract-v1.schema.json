{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pda.local/schemas/scope-contract-v1.schema.json",
  "title": "PDA ScopeContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "turn_id",
    "origin_message_sha256",
    "task_class",
    "objective",
    "targets",
    "actions",
    "completion",
    "budget",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "pda.scope-contract/v1"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "origin_message_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_class": {
      "enum": [
        "answer-only",
        "repository-closeout",
        "bounded-operation",
        "artifact-change",
        "open-mission"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "origin": {
      "description": "Where the contract's authority came from. 'assignment' contracts are injected outside the executing agent; 'self' contracts were declared by the executor and are a weaker audit guarantee.",
      "enum": [
        "assignment",
        "self"
      ]
    },
    "base_commit": {
      "description": "The commit the assigned worktree started from, as resolved by the assigning side at assignment time. Present only on contracts built from a seed that carries it; absent means the base was not recorded, which a consumer that needs it must refuse rather than default.",
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "worktrees",
        "branches",
        "worktree_branches"
      ],
      "properties": {
        "repositories": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "worktrees": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "branches": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "worktree_branches": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "write_paths": {
          "description": "Closed set of repository-relative glob patterns this turn may write. '*' never crosses a path segment; '**' is the recursive form.",
          "allOf": [
            {
              "$ref": "#/$defs/scopePatterns"
            },
            {
              "minItems": 1
            }
          ]
        },
        "test_paths": {
          "description": "Closed set of repository-relative glob patterns for test assets. Omitted or empty means no test asset may be written.",
          "$ref": "#/$defs/scopePatterns"
        }
      }
    },
    "execution": {
      "description": "Second-layer opt-in. Only verification template ids are carried; the id to inspection-rule mapping lives in the gate's closed registry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templates"
      ],
      "properties": {
        "templates": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "focused-test",
              "syntax-check"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "prerequisite",
        "verification",
        "forbidden"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "prerequisite": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "git_write": {
          "description": "Which Git writes this contract carries. The permission comes from the contract, not from the task class, so an assignment can grant writes without granting staging or committing. Omitted is not the same as unrestricted: admission denies a Git write when the field is absent.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": [
              "stage",
              "commit"
            ]
          }
        },
        "verification": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "forbidden": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "blocked_targets_may_be_reported"
      ],
      "properties": {
        "all": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "blocked_targets_may_be_reported": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_seconds",
        "max_tool_calls",
        "max_denied_calls",
        "max_expansions",
        "background_processes",
        "subagents"
      ],
      "properties": {
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_denied_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_expansions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "background_processes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "subagents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "state": {
      "const": "locked"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_class": {
            "const": "repository-closeout"
          }
        },
        "required": [
          "task_class"
        ]
      },
      "then": {
        "required": [
          "budget"
        ],
        "properties": {
          "budget": {
            "required": [
              "max_wall_seconds",
              "max_tool_calls",
              "max_expansions"
            ],
            "properties": {
              "max_wall_seconds": {
                "maximum": 900
              },
              "max_tool_calls": {
                "maximum": 32
              },
              "max_expansions": {
                "const": 0
              },
              "background_processes": {
                "const": 0
              },
              "subagents": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_class": {
            "const": "bounded-operation"
          }
        },
        "required": [
          "task_class"
        ]
      },
      "then": {
        "required": [
          "budget"
        ],
        "properties": {
          "budget": {
            "required": [
              "max_wall_seconds",
              "max_tool_calls",
              "max_expansions"
            ],
            "properties": {
              "max_wall_seconds": {
                "maximum": 1200
              },
              "max_tool_calls": {
                "maximum": 32
              },
              "max_expansions": {
                "maximum": 1
              },
              "background_processes": {
                "const": 0
              },
              "subagents": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_class": {
            "const": "artifact-change"
          }
        },
        "required": [
          "task_class"
        ]
      },
      "then": {
        "required": [
          "budget",
          "targets",
          "execution",
          "origin",
          "actions"
        ],
        "properties": {
          "targets": {
            "required": [
              "write_paths"
            ],
            "properties": {
              "repositories": {
                "maxItems": 1
              },
              "worktrees": {
                "maxItems": 1
              },
              "branches": {
                "maxItems": 1
              }
            }
          },
          "actions": {
            "required": [
              "git_write"
            ]
          },
          "budget": {
            "required": [
              "max_wall_seconds",
              "max_tool_calls",
              "max_expansions"
            ],
            "properties": {
              "max_wall_seconds": {
                "maximum": 3600
              },
              "max_tool_calls": {
                "maximum": 96
              },
              "max_expansions": {
                "maximum": 2
              },
              "background_processes": {
                "const": 0
              },
              "subagents": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true
    },
    "scopePattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)[A-Za-z0-9._*?/\\[\\]-]+$",
      "not": {
        "pattern": "(?:^|/)\\.\\.(?:/|$)"
      }
    },
    "scopePatterns": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scopePattern"
      }
    }
  }
}
