+    @staticmethod
+    def _bounded_plan_text(value: Any, limit: int) -> str:
+        text = re.sub(
+            r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]",
+            " ",
+            str(value or ""),
+        )
+        text = re.sub(r"\s+", " ", text).strip()
+        return redact_sensitive_text(
+            text,
+            force=True,
+            redact_url_credentials=True,
+        )[:limit]
+
+    @classmethod
+    def _plan_items_from_todo_result(
+        cls, result: Any
+    ) -> Optional[List[Dict[str, str]]]:
+        """Project a todo result into a bounded, client-safe plan snapshot."""
+        if isinstance(result, str) and len(result) > cls._MAX_PLAN_RESULT_CHARS:
+            return None
+        try:
+            payload = json.loads(result) if isinstance(result, str) else result
+        except (json.JSONDecodeError, RecursionError, TypeError, ValueError):
+            return None
+        if not isinstance(payload, dict) or not isinstance(payload.get("todos"), list):
+            return None
+
+        raw_items = payload["todos"]
+        if len(raw_items) > 100:
+            return None
+        items: List[Dict[str, str]] = []
+        seen_ids: set[str] = set()
+        valid_statuses = {"pending", "in_progress", "completed", "cancelled"}
+        for raw in raw_items[:100]:
+            if not isinstance(raw, dict):
+                continue
+            status = str(raw.get("status") or "").strip().lower()
+            item_id = cls._bounded_plan_text(raw.get("id"), 100)
+            content = cls._bounded_plan_text(raw.get("content"), 500)
+            if (
+                status not in valid_statuses
+                or not item_id
+                or not content
+                or item_id in seen_ids
+            ):
+                if item_id in seen_ids:
+                    return None
+                continue
+            seen_ids.add(item_id)
+            items.append({"id": item_id, "content": content, "status": status})
+        if raw_items and not items:
+            return None
+        return items
+
