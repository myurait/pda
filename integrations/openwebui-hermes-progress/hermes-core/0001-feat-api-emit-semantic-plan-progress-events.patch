+    @pytest.mark.asyncio
+    async def test_todo_completion_emits_sanitized_plan_update(self, adapter):
+        run_id = "run_plan"
+        queue = asyncio.Queue()
+        adapter._run_streams[run_id] = queue
+        adapter._set_run_status(run_id, "running")
+        callback = adapter._make_run_event_callback(
+            run_id, asyncio.get_running_loop()
+        )
+
+        callback(
+            "tool.completed",
+            "todo",
+            duration=0.1,
+            is_error=False,
+            result=json.dumps(
+                {
+                    "todos": [
+                        {
+                            "id": "investigate",
+                            "content": "通知の発生源を特定する",
+                            "status": "completed",
+                        },
+                        {
+                            "id": "design",
+                            "content": (
+                                "外部\u0000システムとの疎通条件を追加調査する "
+                                "https://user:password@example.com/path?token="
+                                "secret-token-value-1234567890"
+                            ),
+                            "status": "in_progress",
+                        },
+                    ],
+                    "private": "RAW_RESULT_MUST_NOT_LEAK",
+                },
+                ensure_ascii=False,
+            ),
+        )
+
+        completed = await asyncio.wait_for(queue.get(), timeout=0.2)
+        plan = await asyncio.wait_for(queue.get(), timeout=0.2)
+
+        assert completed["event"] == "tool.completed"
+        assert plan == {
+            "event": "plan.updated",
+            "run_id": run_id,
+            "timestamp": plan["timestamp"],
+            "items": [
+                {
+                    "id": "investigate",
+                    "content": "通知の発生源を特定する",
+                    "status": "completed",
+                },
+                {
+                    "id": "design",
+                    "content": (
+                        "外部 システムとの疎通条件を追加調査する "
+                        "https://user:***@example.com/path?token=***"
+                    ),
+                    "status": "in_progress",
+                },
+            ],
+        }
