diff --git a/tests/gateway/test_api_server_runs.py b/tests/gateway/test_api_server_runs.py
index 12669a0e..13480905 100644
--- a/tests/gateway/test_api_server_runs.py
+++ b/tests/gateway/test_api_server_runs.py
@@ -334,6 +334,74 @@ class TestRunEvents:
                 assert "run.completed" in body
                 assert "Hello!" in body
 
+    @pytest.mark.asyncio
+    async def test_events_stream_emits_unstreamed_interim_before_final_delta(
+        self, adapter
+    ):
+        """A real mid-turn assistant message must reach Runs clients before work ends.
+
+        Codex commentary is delivered through ``interim_assistant_callback``, not
+        ``stream_delta_callback``.  The Runs adapter must bridge that separate
+        callback without duplicating commentary that the normal token stream
+        already displayed.
+        """
+        app = _create_runs_app(adapter)
+
+        async with TestClient(TestServer(app)) as cli:
+            with patch.object(adapter, "_create_agent") as mock_create:
+
+                def create_agent(**kwargs):
+                    agent = MagicMock()
+
+                    def run_conversation(**_run_kwargs):
+                        kwargs["interim_assistant_callback"](
+                            "短い計画：状態を確認してから修正します。",
+                            already_streamed=False,
+                        )
+                        kwargs["stream_delta_callback"]("修正と検証が完了しました。")
+                        kwargs["interim_assistant_callback"](
+                            "修正と検証が完了しました。",
+                            already_streamed=True,
+                        )
+                        return {"final_response": "修正と検証が完了しました。"}
+
+                    agent.run_conversation.side_effect = run_conversation
+                    agent.session_prompt_tokens = 0
+                    agent.session_completion_tokens = 0
+                    agent.session_total_tokens = 0
+                    return agent
+
+                mock_create.side_effect = create_agent
+                started = await cli.post("/v1/runs", json={"input": "修正して"})
+                run_id = (await started.json())["run_id"]
+                events = await cli.get(f"/v1/runs/{run_id}/events")
+                body = await events.text()
+
+        payloads = [
+            json.loads(line[6:])
+            for line in body.splitlines()
+            if line.startswith("data: ")
+        ]
+        visible = [
+            item
+            for item in payloads
+            if item.get("event") in {"message.interim", "message.delta"}
+        ]
+        assert visible == [
+            {
+                "event": "message.interim",
+                "run_id": run_id,
+                "timestamp": visible[0]["timestamp"],
+                "content": "短い計画：状態を確認してから修正します。",
+            },
+            {
+                "event": "message.delta",
+                "run_id": run_id,
+                "timestamp": visible[1]["timestamp"],
+                "delta": "修正と検証が完了しました。",
+            },
+        ]
+
     @pytest.mark.asyncio
     async def test_todo_completion_emits_sanitized_plan_update(self, adapter):
         run_id = "run_plan"
