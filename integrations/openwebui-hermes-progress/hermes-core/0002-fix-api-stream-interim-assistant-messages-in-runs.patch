Subject: [PATCH] fix(api): stream interim assistant messages in runs

---
 gateway/platforms/api_server.py               | 24 +++++++
 tests/gateway/test_api_server.py              |  7 +-
 tests/gateway/test_api_server_runs.py         | 68 +++++++++++++++++++
 .../docs/user-guide/features/api-server.md    |  7 ++
 4 files changed, 105 insertions(+), 1 deletion(-)

diff --git a/gateway/platforms/api_server.py b/gateway/platforms/api_server.py
index 78d07c00..d3ed1fc0 100644
--- a/gateway/platforms/api_server.py
+++ b/gateway/platforms/api_server.py
@@ -2618,6 +2618,7 @@ class APIServerAdapter(BasePlatformAdapter):
         ephemeral_system_prompt: Optional[str] = None,
         session_id: Optional[str] = None,
         stream_delta_callback=None,
+        interim_assistant_callback=None,
         tool_progress_callback=None,
         tool_start_callback=None,
         tool_complete_callback=None,
@@ -2930,6 +2931,7 @@ class APIServerAdapter(BasePlatformAdapter):
             "session_id": session_id,
             "platform": "api_server",
             "stream_delta_callback": stream_delta_callback,
+            "interim_assistant_callback": interim_assistant_callback,
             "tool_progress_callback": tool_progress_callback,
             "tool_start_callback": tool_start_callback,
             "tool_complete_callback": tool_complete_callback,
@@ -6832,6 +6834,27 @@ class APIServerAdapter(BasePlatformAdapter):
             except Exception:
                 pass
 
+        def _interim_cb(content: str, already_streamed: bool = False) -> None:
+            """Publish a completed mid-turn assistant message exactly once.
+
+            Codex commentary uses ``interim_assistant_callback`` instead of the
+            ordinary token stream. Other runtimes can send the same text to
+            both callbacks; ``already_streamed`` keeps those paths deduplicated.
+            """
+            if already_streamed or not isinstance(content, str) or not content:
+                return
+            if run_id not in self._run_streams:
+                return
+            try:
+                loop.call_soon_threadsafe(_put_event_if_active, {
+                    "event": "message.interim",
+                    "run_id": run_id,
+                    "timestamp": time.time(),
+                    "content": content,
+                })
+            except Exception:
+                pass
+
         self._set_run_status(
             run_id,
             "queued",
@@ -6864,6 +6887,7 @@ class APIServerAdapter(BasePlatformAdapter):
                         ephemeral_system_prompt=ephemeral_system_prompt,
                         session_id=session_id,
                         stream_delta_callback=_text_cb,
+                        interim_assistant_callback=_interim_cb,
                         tool_progress_callback=event_cb,
                         gateway_session_key=gateway_session_key,
                         requested_model=agent_overrides.get("requested_model"),
