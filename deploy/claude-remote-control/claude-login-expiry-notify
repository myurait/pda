#!/usr/bin/env python3
"""Claude の claude.ai ログインの期限が近づいたらスマホへ ntfy push を送る。

ログインの期限 (ログインから約 29 日) が切れると、再ログインするまで Claude Code は
動かない。ミニ PC では Remote Control の常駐が止まり、開発 PC ではミニ PC から
呼ぶ claude -p が失敗する。期限は認証の refreshTokenExpiresAt にあり、
CLAUDE_CONFIG_DIR を指定したときは $CLAUDE_CONFIG_DIR/.credentials.json から、
macOS で指定しないときはキーチェーンの項目 "Claude Code-credentials" から読む。

systemd のタイマーか launchd から 1 日 1 回呼ばれ、残りが NOTIFY_DAYS 日以下か、
すでに切れているか、期限を読めないときに 1 通送る。判定できないときは送る。

環境変数:
    CLAUDE_LOGIN_NOTIFY_ENV      通知先 (NTFY_TOPIC、NTFY_SERVER) を書いたファイル
    CLAUDE_LOGIN_NOTIFY_DAYS     何日前から送るか (既定 3)
    CLAUDE_LOGIN_NOTIFY_LABEL    タイトルの先頭に付ける機械の名前 (既定 mini-pc)
    CLAUDE_LOGIN_NOTIFY_SUBJECT  切れると止まるもの (既定 Remote Control の常駐)
    CLAUDE_LOGIN_NOTIFY_RELOGIN  本文に載せる再ログインのコマンド

使い方:
    claude-login-expiry-notify            # 判定して必要なら送る
    claude-login-expiry-notify --dry-run  # 送らずに判定と本文だけ表示する
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import pathlib
import subprocess
import sys
import urllib.request

ENV_FILE = pathlib.Path(
    os.environ.get("CLAUDE_LOGIN_NOTIFY_ENV")
    or pathlib.Path.home() / ".config" / "claude-login-notify" / "ntfy.env"
)
NOTIFY_DAYS = int(os.environ.get("CLAUDE_LOGIN_NOTIFY_DAYS") or 3)
LABEL = os.environ.get("CLAUDE_LOGIN_NOTIFY_LABEL") or "mini-pc"
SUBJECT = os.environ.get("CLAUDE_LOGIN_NOTIFY_SUBJECT") or "Remote Control の常駐"
RELOGIN_COMMAND = os.environ.get("CLAUDE_LOGIN_NOTIFY_RELOGIN") or (
    "ssh -t agent-node 'HOME=/home/user/v03/agent-home "
    "CLAUDE_CONFIG_DIR=/home/user/pda/secrets/claude "
    "/home/user/.local/bin/claude auth login'"
)
KEYCHAIN_SERVICE = "Claude Code-credentials"
SECURITY_ITEM_NOT_FOUND = 44
HTTP_TIMEOUT_SECONDS = 10
JST = datetime.timezone(datetime.timedelta(hours=9))


def load_config() -> dict:
    config = {}
    for raw in ENV_FILE.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        config[key.strip()] = value.strip().strip('"').strip("'")
    return config


def expiry_of(data: dict) -> datetime.datetime | None:
    """認証の JSON から期限を返す。ログインしていないときは None。"""
    oauth = data.get("claudeAiOauth") or {}
    expires_ms = oauth.get("refreshTokenExpiresAt") or 0
    if not oauth.get("refreshToken") or expires_ms <= 0:
        return None
    return datetime.datetime.fromtimestamp(expires_ms / 1000, tz=JST)


def read_keychain_expiry() -> datetime.datetime | None:
    """macOS のキーチェーンから期限を読む。項目が無いときはログインしていない。"""
    result = subprocess.run(
        ["/usr/bin/security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
        capture_output=True,
        text=True,
    )
    if result.returncode == SECURITY_ITEM_NOT_FOUND:
        return None
    if result.returncode != 0:
        raise OSError(f"キーチェーンを読めません (security の終了コード {result.returncode})")
    return expiry_of(json.loads(result.stdout))


def read_expiry() -> datetime.datetime | None:
    """ログインの期限を返す。ログインしていないときは None。"""
    config_dir = os.environ.get("CLAUDE_CONFIG_DIR")
    if not config_dir and sys.platform == "darwin":
        return read_keychain_expiry()
    path = pathlib.Path(config_dir or pathlib.Path.home() / ".claude") / ".credentials.json"
    return expiry_of(json.loads(path.read_text(encoding="utf-8")))


def build_notice(now: datetime.datetime) -> tuple[str, str] | None:
    """送るなら (タイトル, 本文)、送らないなら None を返す。"""
    try:
        expiry = read_expiry()
    except (OSError, ValueError) as exc:
        return (f"[{LABEL}] Claude のログインを確認できません", str(exc))
    if expiry is None:
        return (
            f"[{LABEL}] Claude のログインが切れています",
            f"{SUBJECT}は止まっています。再ログイン:\n{RELOGIN_COMMAND}",
        )
    remaining = expiry - now
    if remaining > datetime.timedelta(days=NOTIFY_DAYS):
        return None
    when = expiry.strftime("%m/%d %H:%M")
    if remaining.total_seconds() <= 0:
        title = f"[{LABEL}] Claude のログインが切れています ({when})"
    elif remaining.days >= 1:
        title = f"[{LABEL}] Claude のログインの期限まであと {remaining.days} 日 ({when})"
    else:
        hours = int(remaining.total_seconds() // 3600)
        title = f"[{LABEL}] Claude のログインの期限まであと {hours} 時間 ({when})"
    return (title, f"切れると{SUBJECT}が止まります。再ログイン:\n{RELOGIN_COMMAND}")


def send(config: dict, title: str, message: str) -> None:
    payload = {"topic": config["NTFY_TOPIC"], "title": title, "message": message, "priority": 4}
    request = urllib.request.Request(
        config.get("NTFY_SERVER", "https://ntfy.sh").rstrip("/"),
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
        response.read()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true", help="送らずに判定と本文だけ表示する")
    args = parser.parse_args()

    notice = build_notice(datetime.datetime.now(tz=JST))
    if notice is None:
        print(f"期限まで {NOTIFY_DAYS} 日より先なので送らない")
        return 0
    title, message = notice
    print(f"{title}\n{message}")
    if args.dry_run:
        return 0
    send(load_config(), title, message)
    print("送信した")
    return 0


if __name__ == "__main__":
    sys.exit(main())
