#!/usr/bin/env python3
"""todo とスクラップを扱うサーバー。MCP の口と、iPhone の共有シートから URL を受け取る口を 1 つのポートで持つ。

- `/mcp`: MCP (streamable HTTP)。MCP の公式の Python SDK (2.x の MCPServer。1.x では FastMCP と呼ばれていたもの) で、関数を道具として公開する。
- `/` (POST): 受け口。iPhone のショートカットから届いた URL やテキストを scrap.md の先頭に足してコミットし、続けて見出しを付ける。
- `/` (GET): 動いているかの確認。

127.0.0.1 で待ち受け、tailnet へは Tailscale Serve で公開する。
ファイルの書き方 (todo を一覧の先頭に足す、スクラップを一覧の先頭に足す、見出しの付け方) は、
`todo-scrap-receiver` を同じフォルダから読み込んで使う。
"""

import datetime
import importlib.machinery
import importlib.util
import os
import pathlib
import re

# 受け口を読み込む。受け口の本体は同じフォルダ (~/.local/bin、手元では deploy/todo-scrap) にある。
_RECEIVER = pathlib.Path(__file__).resolve().with_name("todo-scrap-receiver")
_loader = importlib.machinery.SourceFileLoader("todo_scrap_receiver", str(_RECEIVER))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
receiver = importlib.util.module_from_spec(_spec)
_loader.exec_module(receiver)

TODO = os.path.join(receiver.REPO, "todo.md")
HOST = "127.0.0.1"
PORT = int(os.environ.get("TODO_SCRAP_PORT", "18700"))
# tailnet から届くときの Host。これ以外の Host の要求は SDK が断る。
PUBLIC_HOST = os.environ.get("TODO_SCRAP_MCP_PUBLIC_HOST", "pda-web.tailaff53a.ts.net")

TASK = re.compile(r"^- \[( |x|X)\] (.*)$")
SECTION = re.compile(r"^## (.+)$")
SCRAP = re.compile(r"^- \[( |x|X)\] (\d{4}-\d\d-\d\d \d\d:\d\d) (.*)$")

# ---- 属性 ----
# 行の末尾の `[名前: 値]` は SilverBullet の属性で、画面のクエリから項目として引ける。
# 名前は英字・数字・_ (SilverBullet が属性として読むのはこの名前だけ)、値は日本語。
# 書かない属性は「値なし」(todo の status なら未着手、スクラップの aicheck なら未チェック)。
ATTR_TAIL = re.compile(r"\s*\[([A-Za-z0-9_$]+)::?\s*([^\[\]\n]*)\]\s*$")
TODO_ATTRS = ("category", "project", "due", "status", "weight")
SCRAP_ATTRS = ("topic", "aicheck")
CHOICES = {
    "category": ("仕事", "個人開発", "プライベート"),
    "status": ("進行中", "待ち"),
    "weight": ("1", "2", "3"),
    "topic": ("AI", "ゲーム", "開発ツール"),
    "aicheck": ("チェック済み", "反映待ち"),
}
NOT_CHECKED = "未チェック"


def split_attrs(body):
    """行の本文を (属性を除いた本文, {名前: 値}) に分ける。属性は末尾に並んだものだけを読む。"""
    attrs = {}
    while True:
        m = ATTR_TAIL.search(body)
        if not m:
            return body.strip(), attrs
        attrs = {m.group(1): m.group(2).strip(), **attrs}
        body = body[: m.start()]


def join_attrs(body, attrs, order):
    """本文の後ろに属性を足す。order の名前を先に、その順で並べ、ほかの名前は元の順で後ろに置く。"""
    names = [n for n in order if n in attrs] + [n for n in attrs if n not in order]
    tail = "".join(f" [{n}: {attrs[n]}]" for n in names if attrs[n] not in (None, ""))
    return body + tail


def check_attr(name, value):
    """属性の値を確かめて、書く形にして返す。空文字は「属性を消す」。"""
    value = receiver.one_line(value)
    if value == "":
        return ""
    if name == "due":
        try:
            datetime.date.fromisoformat(value)
        except ValueError:
            raise ValueError(f"due は 2026-11-15 の形の日付で渡してください: {value}") from None
        if len(value) != 10:
            raise ValueError(f"due は 2026-11-15 の形の日付で渡してください: {value}")
        return value
    if name in CHOICES:
        if value not in CHOICES[name]:
            raise ValueError(f"{name} に使える値は {'・'.join(CHOICES[name])} です: {value}")
        return value
    # project など自由に書く値。属性の書き方を壊す文字と Space Lua の式の始まりを取り除く。
    return receiver.one_line(value.replace("[", " ").replace("]", " ").replace("${", "$ {"))


def apply_attrs(attrs, changes):
    """changes の値が None の名前はそのまま、空文字なら消し、ほかは確かめて書き換える。"""
    out = dict(attrs)
    for name, value in changes.items():
        if value is None:
            continue
        value = check_attr(name, str(value))
        if value == "":
            out.pop(name, None)
        else:
            out[name] = value
    return out


def todo_fields(body):
    rest, attrs = split_attrs(body)
    weight = attrs.get("weight")
    return {
        "text": rest,
        "category": attrs.get("category"),
        "project": attrs.get("project"),
        "due": attrs.get("due"),
        "status": attrs.get("status"),
        "weight": int(weight) if weight and weight.isdigit() else None,
    }


# ---- ファイルを読み書きする部分 (MCP に依らない。試験はここに当てる) ----


def todo_items(text):
    """todo.md の行を、項目の一覧にする (ページの並び = 新しい順)。"""
    items = []
    for line in text.splitlines():
        m = TASK.match(line)
        if m:
            items.append({**todo_fields(m.group(2)), "done": m.group(1) != " "})
    return items


def sort_by_due(items):
    """期限の近い順に並べる。期限の無いものは後ろに、元の並びのまま置く。"""
    return sorted(items, key=lambda i: (i["due"] is None, i["due"] or ""))


def add_todo_text(text, item):
    """一覧の先頭に `- [ ] item` を足す。新しいものが上に来る。item は属性を含んでよい。"""
    return receiver.add_to_top(text, f"- [ ] {item}")


def sections_to_categories(text, mapping):
    """節 (`## ` の見出し) で分けていた todo.md を、見出しの無い 1 つの一覧にし、節を category の属性に移す。
    mapping は {節の名前: カテゴリ}。並びはページの順のまま。既に category があればそのまま。"""
    out, section, listed = [], None, False
    for line in text.splitlines():
        m = SECTION.match(line)
        if m:
            section = m.group(1).strip()
            if section not in mapping:
                raise ValueError(f"カテゴリを決めていない節があります: {section}")
            continue
        t = TASK.match(line)
        if t:
            body, attrs = split_attrs(t.group(2))
            attrs = {"category": mapping[section], **attrs} if section and "category" not in attrs else attrs
            out.append(f"- [{t.group(1)}] {join_attrs(body, attrs, TODO_ATTRS)}")
            listed = True
        elif line.strip() or not listed:
            out.append(line)
    while out and not out[-1].strip():
        out.pop()
    return "\n".join(out) + "\n"


def set_task_done(text, match, done=True, pattern=TASK):
    """match(本文) が真になる、まだ状態の違う項目を 1 件だけ書き換える。0 件か 2 件以上ならエラー。"""
    lines = text.splitlines(keepends=True)
    hits = []
    for i, line in enumerate(lines):
        m = pattern.match(line.rstrip("\n"))
        if m and (m.group(1) != " ") != done and match(line):
            hits.append(i)
    if len(hits) != 1:
        raise ValueError(f"当てはまる項目が {len(hits)} 件あります。1 件に絞れる文を渡してください。")
    i = hits[0]
    lines[i] = lines[i].replace("- [ ]" if done else "- [x]", "- [x]" if done else "- [ ]", 1)
    return "".join(lines)


def find_one_todo(lines, match):
    """属性を除いた本文に match を含む todo の行を 1 件探す。0 件か 2 件以上ならエラー。(行の位置, 一致) を返す。"""
    hits = []
    for i, line in enumerate(lines):
        m = TASK.match(line.rstrip("\n"))
        if m and match in split_attrs(m.group(2))[0]:
            hits.append((i, m))
    if len(hits) != 1:
        raise ValueError(f"当てはまる項目が {len(hits)} 件あります。1 件に絞れる文を渡してください。")
    return hits[0]


def edit_todo_text(text, match, new_item=None):
    """本文に match を含む項目を 1 件、本文を new_item に書き換える (None なら行を消す)。
    属性は残し、new_item に属性が書いてあればその属性だけ書き換える。
    完了したものも対象。完了かどうかはそのまま。0 件か 2 件以上ならエラー。(新しい本文, 元の本文) を返す。"""
    lines = text.splitlines(keepends=True)
    i, m = find_one_todo(lines, match)
    old_body, attrs = split_attrs(m.group(2))
    if new_item is None:
        del lines[i]
    else:
        new_body, new_attrs = split_attrs(new_item)
        attrs = apply_attrs(attrs, new_attrs)
        item = join_attrs(new_body, attrs, TODO_ATTRS)
        lines[i] = f"- [{m.group(1)}] {item}" + ("\n" if lines[i].endswith("\n") else "")
    return "".join(lines), old_body


def set_todo_attrs_text(text, match, changes):
    """本文に match を含む todo を 1 件探し、属性を changes で書き換える。(新しい本文, その行の本文) を返す。"""
    lines = text.splitlines(keepends=True)
    i, m = find_one_todo(lines, match)
    body, attrs = split_attrs(m.group(2))
    item = join_attrs(body, apply_attrs(attrs, changes), TODO_ATTRS)
    lines[i] = f"- [{m.group(1)}] {item}" + ("\n" if lines[i].endswith("\n") else "")
    return "".join(lines), body


def scrap_items(text):
    """scrap.md の行を、日時・見出し・URL・属性・片付いたかの一覧にする (ファイルの並び = 新しい順)。"""
    items = []
    for line in text.splitlines():
        m = SCRAP.match(line)
        if not m:
            continue
        rest, attrs = split_attrs(m.group(3))
        link = receiver.LINK.search(rest)
        items.append(
            {
                "done": m.group(1) != " ",
                "added": m.group(2),
                "title": link.group(1) if link else rest,
                "url": link.group(2) if link else None,
                "note": receiver.LINK.sub("", rest).strip() if link else "",
                "topic": attrs.get("topic"),
                "aicheck": attrs.get("aicheck") or NOT_CHECKED,
            }
        )
    return items


def find_one_scrap(lines, url):
    hits = [i for i, line in enumerate(lines) if SCRAP.match(line.rstrip("\n")) and f"({url})" in line]
    if len(hits) != 1:
        raise ValueError(f"URL に当てはまるスクラップが {len(hits)} 件あります: {url}")
    return hits[0]


def set_scrap_text(text, url, changes, done=None):
    """URL のスクラップを 1 件探し、属性を changes で書き換える。done が真偽値ならチェック欄も書き換える。"""
    lines = text.splitlines(keepends=True)
    i = find_one_scrap(lines, url)
    m = SCRAP.match(lines[i].rstrip("\n"))
    body, attrs = split_attrs(m.group(3))
    state = m.group(1) if done is None else ("x" if done else " ")
    item = join_attrs(body, apply_attrs(attrs, changes), SCRAP_ATTRS)
    lines[i] = f"- [{state}] {m.group(2)} {item}" + ("\n" if lines[i].endswith("\n") else "")
    return "".join(lines)


def complete_scrap_text(text, url, done=True):
    """URL のスクラップを片付いた (done=True) か、まだ (done=False) にする。
    片付けるとき、AI チェックが反映待ちならチェック済みに戻す (反映が済んだため)。"""
    lines = text.splitlines(keepends=True)
    m = SCRAP.match(lines[find_one_scrap(lines, url)].rstrip("\n"))
    _, attrs = split_attrs(m.group(3))
    changes = {"aicheck": "チェック済み"} if done and attrs.get("aicheck") == "反映待ち" else {}
    return set_scrap_text(text, url, changes, done)


def update_page(path, change, message):
    """ページを change(旧本文) -> 新本文 で書き換えてコミットする。受け口と同じロックを取る。"""
    import fcntl
    import subprocess

    with open(receiver.LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(path, encoding="utf-8") as f:
            old = f.read()
        new = change(old)
        if new == old:
            return
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
        receiver.git("add", os.path.basename(path))
        receiver.git("commit", "-q", "-m", message)
        subprocess.run(["git", "-C", receiver.REPO, "push", "-q", "origin", "HEAD"], capture_output=True)


def read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


# ---- MCP の道具 ----


def build_server():
    from mcp.server.mcpserver import MCPServer

    server = MCPServer(
        name="todo-scrap",
        instructions=(
            "オーナーの個人の todo と、後で読む記事のスクラップを扱う。"
            "オーナーの todo の管理 (一覧・追加・完了・属性・書き換え・削除) とスクラップの管理 (一覧・追加・属性・片付け) は、このサーバーの道具で行う。"
            "ミニ PC の ~/todo-scrap のファイルを直接書き換えない (画面と受け口と同じ書き方を保つため)。"
            "todo は見出しの無い 1 つの一覧で、新しいものを先頭に足す。"
            "todo の属性: category (カテゴリ 仕事・個人開発・プライベート。足すときは必ず付ける)、"
            "project (案件名)、due (期限日 2026-11-15 の形)、status (進行中・待ち。無ければ未着手)、"
            "weight (重さ 1 = 1 時間以内、2 = 半日以内、3 = それ以上)。"
            "スクラップは新しいものが先頭。スクラップの属性: topic (話題 AI・ゲーム・開発ツール。ゲームはゲーム開発を含む。"
            "どれにも当たらなければ付けない)、aicheck (AI チェック。無ければ未チェック、読んだらチェック済み、"
            "開発物に取り込むものは反映待ち)。未チェックのスクラップは AI が中身を読んで topic と aicheck を付ける。"
            "スクラップのチェック欄は、オーナーが片付いたと判断した印 (価値が無かった・オーナーの知識に吸収した・反映が済んだ)。"
            "AI は自分の判断だけでチェック欄を付けず、オーナーとの棚卸しで片付いたものにだけ complete_scrap を使う。"
            "記事の中身を読むときは、X の投稿は https://publish.x.com/oembed、ほかは https://r.jina.ai/<URL> で読む。"
        ),
    )

    @server.tool()
    def list_todos(
        include_done: bool = False,
        category: str | None = None,
        project: str | None = None,
        status: str | None = None,
        order: str = "page",
    ) -> list[dict]:
        """todo の一覧を返す。各項目は text (属性を除いた本文)・category・project・due・status・weight・done (完了か)。
        値の無い属性は null (status なら未着手)。category・project・status で絞れる (status に「未着手」を渡すと status の無いもの)。
        order="page" はページの順 (上が新しい)、order="due" は期限の近い順 (期限の無いものは後ろ)。"""
        items = todo_items(read_text(TODO))
        if not include_done:
            items = [i for i in items if not i["done"]]
        if category is not None:
            items = [i for i in items if i["category"] == category]
        if project is not None:
            items = [i for i in items if i["project"] == project]
        if status is not None:
            items = [i for i in items if (i["status"] or "未着手") == status]
        return sort_by_due(items) if order == "due" else items

    @server.tool()
    def add_todo(
        text: str,
        category: str,
        project: str | None = None,
        due: str | None = None,
        status: str | None = None,
        weight: int | None = None,
    ) -> str:
        """todo を一覧の先頭に足す。category (仕事・個人開発・プライベート) は必ず渡す。
        ほかの属性は省けば付けない。due は 2026-11-15 の形、status は 進行中・待ち、weight は 1・2・3。"""
        text = receiver.one_line(text)
        if not text:
            raise ValueError("text が空です")
        if not category:
            raise ValueError("category を渡してください (仕事・個人開発・プライベート)")
        attrs = apply_attrs(
            {}, {"category": category, "project": project, "due": due, "status": status, "weight": weight}
        )
        item = join_attrs(text, attrs, TODO_ATTRS)
        update_page(TODO, lambda t: add_todo_text(t, item), f"todo を足す: {item[:80]}")
        return f"足しました: {item}"

    @server.tool()
    def complete_todo(text: str, done: bool = True) -> str:
        """本文に text を含む todo を 1 件、完了 (done=True) か未完了 (done=False) にする。複数に当たるときは失敗する。"""
        update_page(
            TODO,
            lambda t: set_task_done(t, lambda line: text in split_attrs(TASK.match(line.rstrip("\n")).group(2))[0], done),
            f"todo を{'完了' if done else '未完了'}にする: {text[:80]}",
        )
        return f"{'完了' if done else '未完了'}にしました: {text}"

    @server.tool()
    def set_todo_attributes(
        text: str,
        category: str | None = None,
        project: str | None = None,
        due: str | None = None,
        status: str | None = None,
        weight: int | str | None = None,
    ) -> str:
        """本文に text を含む todo を 1 件探し、属性を書き換える。省いた属性はそのまま、空文字 "" を渡すと消す
        (status を消すと未着手)。category は 仕事・個人開発・プライベート、due は 2026-11-15 の形、
        status は 進行中・待ち、weight は 1・2・3。複数に当たるときは失敗する。"""
        changes = {"category": category, "project": project, "due": due, "status": status, "weight": weight}
        found = {}

        def change(t):
            out, found["body"] = set_todo_attrs_text(t, text, changes)
            return out

        given = {k: v for k, v in changes.items() if v is not None}
        update_page(TODO, change, f"todo の属性を変える: {text[:60]} {given}")
        return f"属性を変えました: {found['body']} {given}"

    @server.tool()
    def replace_todo(text: str, new_text: str) -> str:
        """本文に text を含む todo を 1 件、本文を new_text に書き換える。完了かどうかと属性はそのまま。
        new_text の末尾に `[名前: 値]` を書くと、その属性も書き換える。複数に当たるときは失敗する。"""
        new_text = receiver.one_line(new_text)
        if not new_text:
            raise ValueError("new_text が空です")
        found = {}

        def change(t):
            out, found["old"] = edit_todo_text(t, text, new_text)
            return out

        update_page(TODO, change, f"todo を書き換える: {text[:80]} → {new_text[:80]}")
        return f"書き換えました: {found['old']} → {new_text}"

    @server.tool()
    def delete_todo(text: str) -> str:
        """本文に text を含む todo を 1 件消す。完了したものも消せる。複数に当たるときは失敗する。"""
        found = {}

        def change(t):
            out, found["old"] = edit_todo_text(t, text)
            return out

        update_page(TODO, change, f"todo を消す: {text[:80]}")
        return f"消しました: {found['old']}"

    @server.tool()
    def list_scraps(
        include_done: bool = False,
        aicheck: str | None = None,
        topic: str | None = None,
        limit: int = 50,
    ) -> list[dict]:
        """スクラップの一覧を新しい順に返す。各項目は added (届いた日時)・title (見出し)・url・note (添えた文)・
        topic (話題。無ければ null)・aicheck (未チェック・チェック済み・反映待ち)・done (オーナーが片付けたか)。
        既定は片付いていないものだけ。aicheck・topic で絞れる。"""
        items = scrap_items(read_text(receiver.SCRAP))
        if not include_done:
            items = [i for i in items if not i["done"]]
        if aicheck is not None:
            items = [i for i in items if i["aicheck"] == aicheck]
        if topic is not None:
            items = [i for i in items if i["topic"] == topic]
        return items[:limit]

    @server.tool()
    def add_scrap(url_or_text: str, title: str | None = None, topic: str | None = None) -> str:
        """スクラップを一覧の先頭に足す。URL なら追跡用のパラメーターを外し、見出し (X は投稿の文の頭、ほかはページのタイトル) を付ける。
        topic (AI・ゲーム・開発ツール) を渡すと話題も付ける。"""
        entry = receiver.parse(receiver.json.dumps({"url": url_or_text, "title": title or ""}), "application/json")
        if not entry:
            raise ValueError("url_or_text が空です")
        attrs = apply_attrs({}, {"topic": topic})
        receiver.append(join_attrs(entry, attrs, SCRAP_ATTRS))
        found = receiver.placeholder_link(entry)
        if found:
            receiver.retitle(*found)
        return f"足しました: {entry}"

    @server.tool()
    def set_scrap_attributes(url: str, topic: str | None = None, aicheck: str | None = None) -> str:
        """URL のスクラップの属性を書き換える。省いた属性はそのまま、空文字 "" を渡すと消す。
        topic は AI・ゲーム・開発ツール (どれにも当たらなければ付けない)。
        aicheck は チェック済み・反映待ち ("" か「未チェック」で未チェックに戻す)。チェック欄は変えない。"""
        if aicheck == NOT_CHECKED:
            aicheck = ""
        changes = {"topic": topic, "aicheck": aicheck}
        update_page(
            receiver.SCRAP,
            lambda t: set_scrap_text(t, url, changes),
            f"スクラップの属性を変える: {url} {({k: v for k, v in changes.items() if v is not None})}",
        )
        return f"属性を変えました: {url}"

    @server.tool()
    def complete_scrap(url: str, done: bool = True) -> str:
        """URL のスクラップのチェック欄を付ける (done=True) か外す (done=False)。チェック欄はオーナーが片付いたと判断した印なので、
        オーナーとの棚卸しで片付いたもの (価値が無かった・オーナーの知識に吸収した・反映が済んだ) にだけ使う。
        反映待ちのものを片付けると、AI チェックはチェック済みに戻る。"""
        update_page(
            receiver.SCRAP,
            lambda t: complete_scrap_text(t, url, done),
            f"スクラップを{'片付ける' if done else '片付けを戻す'}: {url}",
        )
        return f"{'片付けました' if done else '片付けを戻しました'}: {url}"

    # ---- iPhone の共有シートからの受け口 ----
    from starlette.responses import PlainTextResponse
    import anyio

    @server.custom_route("/", methods=["GET"], include_in_schema=False)
    async def alive(request):
        return PlainTextResponse("todo-scrap の受け口は動いています")

    @server.custom_route("/", methods=["POST"], include_in_schema=False)
    async def receive(request):
        body = await request.body()
        if not body or len(body) > receiver.MAX_BODY:
            return PlainTextResponse("本文が空か、大きすぎます", status_code=400)
        try:
            entry = receiver.parse(body.decode("utf-8", errors="replace"), request.headers.get("content-type", ""))
        except receiver.json.JSONDecodeError:
            return PlainTextResponse("JSON を読めませんでした", status_code=400)
        if not entry:
            return PlainTextResponse("url か text がありません", status_code=400)
        try:
            await anyio.to_thread.run_sync(receiver.append, entry)
        except receiver.subprocess.CalledProcessError as e:
            detail = e.stderr.decode(errors="replace")[:200] if e.stderr else ""
            return PlainTextResponse(f"保存はしましたが、コミットに失敗しました: {detail}", status_code=500)
        # 見出しは返事のあとで付ける (iPhone を待たせない)
        receiver.retitle_later(entry)
        return PlainTextResponse(f"スクラップに足しました: {entry[:60]}")

    return server


