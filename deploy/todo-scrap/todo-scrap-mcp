#!/usr/bin/env python3
"""todo とスクラップを扱うサーバー。MCP の口と、iPhone の共有シートから URL を受け取る口を 1 つのポートで持つ。

- `/mcp`: MCP (streamable HTTP)。MCP の公式の Python SDK (2.x の MCPServer。1.x では FastMCP と呼ばれていたもの) で、関数を道具として公開する。
- `/` (POST): 受け口。iPhone のショートカットから届いた URL やテキストを scrap.md の先頭に足してコミットし、続けて見出しを付ける。
- `/` (GET): 動いているかの確認。

127.0.0.1 で待ち受け、tailnet へは Tailscale Serve で公開する。
ファイルの書き方 (todo を節の先頭に足す、スクラップを一覧の先頭に足す、見出しの付け方) は、
`todo-scrap-receiver` を同じフォルダから読み込んで使う。
"""

import importlib.machinery
import importlib.util
import os
import pathlib
import re

# 受け口を読み込む。受け口の本体は同じフォルダ (~/.local/bin、手元では deploy/todo-scrap) にある。
_RECEIVER = pathlib.Path(__file__).resolve().with_name("todo-scrap-receiver")
_loader = importlib.machinery.SourceFileLoader("todo_scrap_receiver", str(_RECEIVER))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
receiver = importlib.util.module_from_spec(_spec)
_loader.exec_module(receiver)

TODO = os.path.join(receiver.REPO, "todo.md")
HOST = "127.0.0.1"
PORT = int(os.environ.get("TODO_SCRAP_PORT", "18700"))
# tailnet から届くときの Host。これ以外の Host の要求は SDK が断る。
PUBLIC_HOST = os.environ.get("TODO_SCRAP_MCP_PUBLIC_HOST", "pda-web.tailaff53a.ts.net")

TASK = re.compile(r"^- \[( |x|X)\] (.*)$")
SECTION = re.compile(r"^## (.+)$")
SCRAP = re.compile(r"^- \[( |x|X)\] (\d{4}-\d\d-\d\d \d\d:\d\d) (.*)$")


# ---- ファイルを読み書きする部分 (MCP に依らない。試験はここに当てる) ----


def todo_items(text):
    """todo.md の行を、節ごとの項目の一覧にする。"""
    items, section = [], None
    for line in text.splitlines():
        m = SECTION.match(line)
        if m:
            section = m.group(1).strip()
            continue
        m = TASK.match(line)
        if m:
            items.append({"section": section, "text": m.group(2).strip(), "done": m.group(1) != " "})
    return items


def todo_sections(text):
    return [m.group(1).strip() for m in map(SECTION.match, text.splitlines()) if m]


def add_todo_text(text, item, section=None):
    """節の見出しのすぐ下 (節の先頭) に `- [ ] item` を足す。section が無ければ最初の節。"""
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        m = SECTION.match(line.rstrip("\n"))
        if m and (section is None or m.group(1).strip() == section):
            if not line.endswith("\n"):
                lines[i] = line + "\n"
            return "".join(lines[: i + 1] + [f"- [ ] {item}\n"] + lines[i + 1 :])
    raise ValueError(f"節が見つかりません: {section}。ある節: {', '.join(todo_sections(text))}")


def set_task_done(text, match, done=True, pattern=TASK):
    """match(本文) が真になる、まだ状態の違う項目を 1 件だけ書き換える。0 件か 2 件以上ならエラー。"""
    lines = text.splitlines(keepends=True)
    hits = []
    for i, line in enumerate(lines):
        m = pattern.match(line.rstrip("\n"))
        if m and (m.group(1) != " ") != done and match(line):
            hits.append(i)
    if len(hits) != 1:
        raise ValueError(f"当てはまる項目が {len(hits)} 件あります。1 件に絞れる文を渡してください。")
    i = hits[0]
    lines[i] = lines[i].replace("- [ ]" if done else "- [x]", "- [x]" if done else "- [ ]", 1)
    return "".join(lines)


def edit_todo_text(text, match, new_item=None):
    """本文に match を含む項目を 1 件、本文を new_item に書き換える (None なら行を消す)。
    完了したものも対象。節と完了かどうかはそのまま。0 件か 2 件以上ならエラー。(新しい本文, 元の本文) を返す。"""
    lines = text.splitlines(keepends=True)
    hits = []
    for i, line in enumerate(lines):
        m = TASK.match(line.rstrip("\n"))
        if m and match in m.group(2):
            hits.append((i, m))
    if len(hits) != 1:
        raise ValueError(f"当てはまる項目が {len(hits)} 件あります。1 件に絞れる文を渡してください。")
    i, m = hits[0]
    if new_item is None:
        del lines[i]
    else:
        lines[i] = f"- [{m.group(1)}] {new_item}" + ("\n" if lines[i].endswith("\n") else "")
    return "".join(lines), m.group(2).strip()


def scrap_items(text):
    """scrap.md の行を、日時・見出し・URL・既読の一覧にする (ファイルの並び = 新しい順)。"""
    items = []
    for line in text.splitlines():
        m = SCRAP.match(line)
        if not m:
            continue
        rest = m.group(3)
        link = receiver.LINK.search(rest)
        items.append(
            {
                "read": m.group(1) != " ",
                "added": m.group(2),
                "title": link.group(1) if link else rest,
                "url": link.group(2) if link else None,
                "note": receiver.LINK.sub("", rest).strip() if link else "",
            }
        )
    return items


def update_page(path, change, message):
    """ページを change(旧本文) -> 新本文 で書き換えてコミットする。受け口と同じロックを取る。"""
    import fcntl
    import subprocess

    with open(receiver.LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(path, encoding="utf-8") as f:
            old = f.read()
        new = change(old)
        if new == old:
            return
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
        receiver.git("add", os.path.basename(path))
        receiver.git("commit", "-q", "-m", message)
        subprocess.run(["git", "-C", receiver.REPO, "push", "-q", "origin", "HEAD"], capture_output=True)


def read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


# ---- MCP の道具 ----


def build_server():
    from mcp.server.mcpserver import MCPServer

    server = MCPServer(
        name="todo-scrap",
        instructions=(
            "オーナーの個人の todo と、後で読む記事のスクラップを扱う。"
            "オーナーの todo の管理 (一覧・追加・完了・書き換え・削除) とスクラップの管理 (一覧・追加・既読) は、このサーバーの道具で行う。"
            "ミニ PC の ~/todo-scrap のファイルを直接書き換えない (画面と受け口と同じ書き方を保つため)。"
            "todo は節 (仕事・PDA の開発・自分のこと など) に分かれ、新しいものは節の先頭に足す。"
            "スクラップは新しいものが先頭。記事の中身を読むときは、X の投稿は https://publish.x.com/oembed、"
            "ほかは https://r.jina.ai/<URL> で読む。"
        ),
    )

    @server.tool()
    def list_todos(include_done: bool = False) -> list[dict]:
        """todo の一覧を返す。各項目は section (節)・text (本文)・done (完了か)。並びはページの順 (節の中では上が新しい)。"""
        items = todo_items(read_text(TODO))
        return items if include_done else [i for i in items if not i["done"]]

    @server.tool()
    def add_todo(text: str, section: str | None = None) -> str:
        """todo を節の先頭に足す。section を省くと最初の節。節の名前は list_todos の section か、ページの `## ` の見出し。"""
        text = receiver.one_line(text)
        if not text:
            raise ValueError("text が空です")
        update_page(TODO, lambda t: add_todo_text(t, text, section), f"todo を足す: {text[:80]}")
        return f"足しました: {text}"

    @server.tool()
    def complete_todo(text: str, done: bool = True) -> str:
        """本文に text を含む todo を 1 件、完了 (done=True) か未完了 (done=False) にする。複数に当たるときは失敗する。"""
        update_page(
            TODO,
            lambda t: set_task_done(t, lambda line: text in line, done),
            f"todo を{'完了' if done else '未完了'}にする: {text[:80]}",
        )
        return f"{'完了' if done else '未完了'}にしました: {text}"

    @server.tool()
    def replace_todo(text: str, new_text: str) -> str:
        """本文に text を含む todo を 1 件、本文を new_text に書き換える。節と完了かどうかはそのまま。複数に当たるときは失敗する。"""
        new_text = receiver.one_line(new_text)
        if not new_text:
            raise ValueError("new_text が空です")
        found = {}

        def change(t):
            out, found["old"] = edit_todo_text(t, text, new_text)
            return out

        update_page(TODO, change, f"todo を書き換える: {text[:80]} → {new_text[:80]}")
        return f"書き換えました: {found['old']} → {new_text}"

    @server.tool()
    def delete_todo(text: str) -> str:
        """本文に text を含む todo を 1 件消す。完了したものも消せる。複数に当たるときは失敗する。"""
        found = {}

        def change(t):
            out, found["old"] = edit_todo_text(t, text)
            return out

        update_page(TODO, change, f"todo を消す: {text[:80]}")
        return f"消しました: {found['old']}"

    @server.tool()
    def list_scraps(include_read: bool = False, limit: int = 50) -> list[dict]:
        """スクラップの一覧を新しい順に返す。各項目は added (届いた日時)・title (見出し)・url・note (添えた文)・read (既読か)。"""
        items = scrap_items(read_text(receiver.SCRAP))
        if not include_read:
            items = [i for i in items if not i["read"]]
        return items[:limit]

    @server.tool()
    def add_scrap(url_or_text: str, title: str | None = None) -> str:
        """スクラップを一覧の先頭に足す。URL なら追跡用のパラメーターを外し、見出し (X は投稿の文の頭、ほかはページのタイトル) を付ける。"""
        entry = receiver.parse(receiver.json.dumps({"url": url_or_text, "title": title or ""}), "application/json")
        if not entry:
            raise ValueError("url_or_text が空です")
        receiver.append(entry)
        found = receiver.placeholder_link(entry)
        if found:
            receiver.retitle(*found)
        return f"足しました: {entry}"

    @server.tool()
    def mark_scrap_read(url: str, read: bool = True) -> str:
        """URL のスクラップを既読 (read=True) か未読 (read=False) にする。"""
        update_page(
            receiver.SCRAP,
            lambda t: set_task_done(t, lambda line: f"({url})" in line, read, SCRAP),
            f"スクラップを{'既読' if read else '未読'}にする: {url}",
        )
        return f"{'既読' if read else '未読'}にしました: {url}"

    # ---- iPhone の共有シートからの受け口 ----
    from starlette.responses import PlainTextResponse
    import anyio

    @server.custom_route("/", methods=["GET"], include_in_schema=False)
    async def alive(request):
        return PlainTextResponse("todo-scrap の受け口は動いています")

    @server.custom_route("/", methods=["POST"], include_in_schema=False)
    async def receive(request):
        body = await request.body()
        if not body or len(body) > receiver.MAX_BODY:
            return PlainTextResponse("本文が空か、大きすぎます", status_code=400)
        try:
            entry = receiver.parse(body.decode("utf-8", errors="replace"), request.headers.get("content-type", ""))
        except receiver.json.JSONDecodeError:
            return PlainTextResponse("JSON を読めませんでした", status_code=400)
        if not entry:
            return PlainTextResponse("url か text がありません", status_code=400)
        try:
            await anyio.to_thread.run_sync(receiver.append, entry)
        except receiver.subprocess.CalledProcessError as e:
            detail = e.stderr.decode(errors="replace")[:200] if e.stderr else ""
            return PlainTextResponse(f"保存はしましたが、コミットに失敗しました: {detail}", status_code=500)
        # 見出しは返事のあとで付ける (iPhone を待たせない)
        receiver.retitle_later(entry)
        return PlainTextResponse(f"スクラップに足しました: {entry[:60]}")

    return server


if __name__ == "__main__":
    from mcp.server.transport_security import TransportSecuritySettings

    hosts = [f"127.0.0.1:{PORT}", f"localhost:{PORT}", PUBLIC_HOST, f"{PUBLIC_HOST}:{PORT}"]
    build_server().run(
        "streamable-http",
        host=HOST,
        port=PORT,
        stateless_http=True,
        json_response=True,
        transport_security=TransportSecuritySettings(allowed_hosts=hosts, allowed_origins=[]),
    )
