[Unit]
Description=todo-scrap のサーバー (MCP の口と、iPhone の共有シートから URL を受け取る口)
After=network-online.target

[Service]
Environment=TODO_SCRAP_REPO=/home/user/todo-scrap
ExecStart=/home/user/.local/share/todo-scrap-mcp/venv/bin/python /home/user/.local/bin/todo-scrap-mcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
