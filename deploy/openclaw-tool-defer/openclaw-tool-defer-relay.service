[Unit]
Description=OpenClaw tool-defer relay (marks rarely used OpenClaw MCP tools as deferred for Claude Code)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/user/pda/deploy/openclaw-tool-defer/relay.py
Environment=TOOL_DEFER_PORT=37191
Environment=TOOL_DEFER_LOG=/home/user/.local/state/openclaw-tool-defer/relay.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
