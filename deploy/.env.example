# Copy to deploy/.env; do not commit the real credentials.
ZO_ROOT_USER_EMAIL=pda@example.com
ZO_ROOT_USER_PASSWORD=replace-with-a-local-password
# Base64 of ZO_ROOT_USER_EMAIL:ZO_ROOT_USER_PASSWORD, prefixed by "Basic ".
OPENOBSERVE_AUTH=Basic REPLACE_WITH_BASE64
JEV_MODE=fixture
CODEX_AUTH_DIR=../secrets/codex
CLAUDE_AUTH_DIR=../secrets/claude
PDA_FIXTURE_EXECUTOR=
PDA_FIXTURE_TYPE=implement
FAKE_B_MODE=echo
FAKE_SLEEP_SECONDS=700
# Disable only during the response-timeout failure-injection test.
FAKE_B_LEASE_EXTEND=true

# Default UI port is 5000. Override only when that host port is already in use.
CONDUCTOR_UI_PORT=5000
