[Unit]
Description=PDA iPhone Home Screen notification diagnostic
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.local/state/pda/webpush-spike/service.env
ExecStart=%h/.local/state/pda/webpush-spike/venv/bin/python %h/.local/state/pda/webpush-spike/runtime/server.py --state-dir %h/.local/state/pda/webpush-spike --owner-id ${PDA_PUSH_OWNER_ID}
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
