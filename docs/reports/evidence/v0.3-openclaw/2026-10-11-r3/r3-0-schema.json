        },
        "hintPath": "plugins.entries.*.hooks.allowPromptInjection"
      },
      {
        "key": "allowConversationAccess",
        "path": "plugins.entries.*.hooks.allowConversationAccess",
        "type": "boolean",
        "required": false,
        "hasChildren": false,
        "reloadKind": "hot",
        "hint": {
          "label": "Allow Conversation Access Hooks",
