  "mcp": {
    "path": "mcp",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "title": "MCP",
      "description": "Global MCP server definitions managed by OpenClaw. Embedded OpenClaw and other runtime adapters can consume these servers without storing them inside runtime-owned project settings."
    },
    "reloadKind": "hot",
    "hint": {
      "docsUrl": "https://docs.openclaw.ai/tools/mcp",
      "label": "MCP",
      "help": "Global MCP server definitions managed by OpenClaw. Embedded OpenClaw and other runtime adapters can consume these servers without storing them inside runtime-owned project settings.",
      "advanced": true
    },
    "hintPath": "mcp",
    "children": [
      {
        "key": "sessionIdleTtlMs",
        "path": "mcp.sessionIdleTtlMs",
        "type": "number",
        "required": false,
        "hasChildren": false,
        "reloadKind": "hot",
        "hint": {
          "label": "MCP Session Idle TTL (ms)",
          "help": "Optional idle eviction for OpenClaw session MCP runtimes in milliseconds. Unset or 0 keeps runtimes alive until session cleanup or Gateway shutdown. Positive values round down; active leases and pending acquisitions prevent eviction. Run-owned runtimes still retire when their one-shot run ends.",
          "advanced": true
        },
        "hintPath": "mcp.sessionIdleTtlMs"
      },
      {
        "key": "servers",
        "path": "mcp.servers",
        "type": "object",
        "required": false,
        "hasChildren": true,
        "reloadKind": "hot",
        "hint": {
          "label": "MCP Servers",
          "help": "Named MCP server definitions. OpenClaw stores them in its own config and runtime adapters decide which transports are supported at execution time.",
          "advanced": true
        },
        "hintPath": "mcp.servers"
      },
      {
        "key": "apps",
        "path": "mcp.apps",
        "type": "object",
        "required": false,
        "hasChildren": true,
        "reloadKind": "restart",
        "hint": {
          "label": "MCP Apps",
          "help": "MCP Apps UI support. When enabled, configured MCP servers may provide interactive HTML views for their tool results.",
          "advanced": true
        },
        "hintPath": "mcp.apps"
      }
    ]
  },
