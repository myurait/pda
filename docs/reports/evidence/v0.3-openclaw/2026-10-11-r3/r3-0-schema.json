        "required": false,
        "hasChildren": false,
        "reloadKind": "hot",
        "hint": {
          "label": "Allow Prompt Injection Hooks",
          "help": "Controls whether this plugin may mutate prompts through typed hooks. Set false to block `before_prompt_build`.",
