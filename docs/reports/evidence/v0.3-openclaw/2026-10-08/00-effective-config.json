{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 5114,
    "controlUi": {
      "enabled": true,
      "sessionObserver": false
    },
    "tailscale": {
      "mode": "off"
    }
  },
  "gatewayAuthMode": "none",
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "workspace": "/home/user/v03/work/openclaw/scratch",
      "cwd": "/home/user/v03/work/openclaw/scratch",
      "skipBootstrap": true,
      "skills": [],
      "heartbeat": {
        "every": "0m"
      },
      "timeoutSeconds": 300,
      "utilityModel": "",
      "models": {
        "openai/gpt-6-astra": {
          "agentRuntime": {
            "id": "codex"
          }
        },
        "anthropic/claude-sonnet-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        }
      }
    },
    "entries": {
      "claude": {
        "name": "Claude Code",
        "workspace": "/home/user/v03/work/openclaw/scratch",
        "cwd": "/home/user/v03/work/openclaw/scratch",
        "model": "anthropic/claude-sonnet-5",
        "verboseDefault": "on",
        "subagents": {
          "allowAgents": [
            "codex"
          ]
        },
        "models": {
          "anthropic/claude-sonnet-5": {
            "agentRuntime": {
              "id": "claude-cli"
            }
          }
        }
      },
      "codex": {
        "name": "Codex",
        "workspace": "/home/user/v03/work/openclaw/scratch",
        "cwd": "/home/user/v03/work/openclaw/scratch",
        "model": "openai/gpt-6-astra",
        "verboseDefault": "on",
        "subagents": {
          "allowAgents": [
            "claude"
          ]
        }
      }
    }
  },
  "plugins": {
    "codex": {
      "enabled": true,
      "config": {
        "appServer": {
          "homeScope": "user",
          "command": "/home/user/.local/bin/codex",
          "mode": "yolo"
        },
        "sessionCatalog": {
          "enabled": false
        }
      }
    },
    "anthropic": {
      "config": {
        "sessionCatalog": {
          "enabled": false
        }
      },
      "enabled": true
    },
    "acpx": {
      "enabled": false
    }
  },
  "update": {
    "checkOnStart": false
  },
  "cron": {
    "enabled": false
  }
}
